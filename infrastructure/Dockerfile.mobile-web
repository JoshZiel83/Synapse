FROM node:22-alpine AS builder
WORKDIR /app
RUN apk add --no-cache git
RUN git init
RUN npm config set registry https://registry.npmmirror.com \
  && npm config set fetch-retries 5 \
  && npm config set fetch-retry-mintimeout 20000 \
  && npm config set fetch-retry-maxtimeout 120000

COPY package.json package-lock.json ./
COPY tsconfig.base.json ./
# All workspace manifests must exist so `npm ci` can validate the lockfile,
# even though this image only builds device-protocol + shared (+ the
# isolated mobile-app install below).
COPY packages/device-protocol/package.json packages/device-protocol/
COPY packages/shared/package.json packages/shared/
COPY packages/device-runtime/package.json packages/device-runtime/
COPY packages/device-sdk/package.json packages/device-sdk/
COPY packages/device-runtime-bundles-linux-x64/package.json packages/device-runtime-bundles-linux-x64/
COPY packages/device-runtime-bundles-linux-arm64/package.json packages/device-runtime-bundles-linux-arm64/
COPY packages/device-runtime-bundles-darwin-x64/package.json packages/device-runtime-bundles-darwin-x64/
COPY packages/device-runtime-bundles-darwin-arm64/package.json packages/device-runtime-bundles-darwin-arm64/
COPY packages/device-runtime-bundles-win32-x64/package.json packages/device-runtime-bundles-win32-x64/
COPY packages/device-runtime-bundles-win32-arm64/package.json packages/device-runtime-bundles-win32-arm64/
COPY packages/api/package.json packages/api/
COPY packages/remote-agent-daemon/package.json packages/remote-agent-daemon/
COPY packages/web-next/package.json packages/web-next/
RUN npm ci --workspace=packages/device-protocol --workspace=packages/shared

# @synapse/shared value-imports @synapse/device-protocol/browser-tools, so
# device-protocol must be built before shared.
COPY packages/device-protocol/ packages/device-protocol/
COPY packages/shared/ packages/shared/
RUN npm run build -w packages/device-protocol && npm run build -w packages/shared

COPY packages/mobile-app/package.json packages/mobile-app/package-lock.json packages/mobile-app/

WORKDIR /app/packages/mobile-app
RUN npm ci

WORKDIR /app
COPY packages/mobile-app/ packages/mobile-app/

ARG EXPO_PUBLIC_API_URL
ARG EXPO_PUBLIC_AUTH_ORIGIN
ARG EXPO_BASE_URL=/mobile
ENV EXPO_PUBLIC_API_URL=${EXPO_PUBLIC_API_URL}
# Public origin Better Auth is mounted on. Optional: defaults to the API origin
# when unset (fine for same-origin deploys); set it when the browser-facing
# public origin differs from the internal API origin.
ENV EXPO_PUBLIC_AUTH_ORIGIN=${EXPO_PUBLIC_AUTH_ORIGIN}
ENV EXPO_BASE_URL=${EXPO_BASE_URL}
ENV NODE_ENV=production

WORKDIR /app/packages/mobile-app
RUN npm run build:chat-worker
RUN npx expo export --platform web --output-dir /tmp/synapse-mobile-web-export

FROM nginx:alpine
COPY infrastructure/nginx/mobile-web.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /tmp/synapse-mobile-web-export/ /usr/share/nginx/html/mobile/
EXPOSE 80
