[Unit]
Description=Synapse API Backend
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/project/synapse
Environment=NODE_ENV=production
EnvironmentFile=/home/ubuntu/project/synapse/.env
ExecStartPre=/usr/bin/npm run build -w packages/shared
ExecStartPre=/usr/bin/npm run build -w packages/api
ExecStart=/home/ubuntu/project/synapse/infrastructure/scripts/start-api.sh
Restart=on-failure
RestartPreventExitStatus=200
RestartSec=5

[Install]
WantedBy=multi-user.target
