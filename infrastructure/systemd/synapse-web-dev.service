[Unit]
Description=Synapse Web Frontend (Dev)
After=network.target synapse-api.service
Wants=synapse-api.service
Conflicts=synapse-web.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/project/synapse/packages/web-next
EnvironmentFile=/home/ubuntu/project/synapse/packages/web-next/.env.local
ExecStart=/home/ubuntu/project/synapse/infrastructure/scripts/start-web-dev.sh
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
