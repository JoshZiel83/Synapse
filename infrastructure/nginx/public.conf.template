    ssl_certificate_key /etc/letsencrypt/live/${LETSENCRYPT_CERT_NAME}/privkey.pem;
    ssl_trusted_certificate /etc/letsencrypt/live/${LETSENCRYPT_CERT_NAME}/chain.pem;
    ssl_session_cache shared:SynapseSSL:10m;
