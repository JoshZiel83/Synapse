map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

# NOTE: no static `upstream {}` blocks for api/web/mobile-web. An upstream block
# (or a literal proxy_pass hostname) resolves the container name ONCE at config
# load, so recreating a backend (it gets a new docker IP) strands nginx on the
# stale IP → permanent 502 until nginx reloads. Instead each location below uses a
# `set $var ...; proxy_pass http://$var:port;` form, which makes nginx re-resolve
# via docker's embedded DNS (127.0.0.11) on a timer (the resolver `valid=` TTL
# below) — NO reload needed. A backend recreate may still 502 briefly, at most
# until that TTL expires, instead of forever. (Same pattern the registry vhost
# already uses for verdaccio.)

server {
    listen 80;
    listen [::]:80;
    server_name ${SYNAPSE_PUBLIC_DOMAIN} ${SYNAPSE_WWW_DOMAIN} ${SYNAPSE_MOBILE_SHORT_DOMAIN} ${SYNAPSE_MOBILE_DOMAIN} ${SYNAPSE_REGISTRY_DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
        try_files $uri =404;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    listen 443 quic reuseport;
    listen [::]:443 quic reuseport;
    http2 on;
    http3 on;
    server_name ${SYNAPSE_PUBLIC_DOMAIN} ${SYNAPSE_WWW_DOMAIN};

    ssl_certificate /etc/letsencrypt/live/${LETSENCRYPT_CERT_NAME}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${LETSENCRYPT_CERT_NAME}/privkey.pem;
    ssl_trusted_certificate /etc/letsencrypt/live/${LETSENCRYPT_CERT_NAME}/chain.pem;
    ssl_session_cache shared:SynapseSSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_stapling on;
    ssl_stapling_verify on;
    quic_retry on;
    resolver 127.0.0.11 valid=30s ipv6=off;
    resolver_timeout 5s;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header Alt-Svc 'h3=":443"; ma=86400' always;

    client_max_body_size 25m;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $host;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
        try_files $uri =404;
    }

    location ~ /\.(?!well-known/acme-challenge/) {
        return 404;
    }

    location /api/ {
        set $api_upstream api;
        proxy_pass http://$api_upstream:3001;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }

    location /ws {
        set $api_upstream api;
        proxy_pass http://$api_upstream:3001;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 86400s;
    }

    location /mobile/ {
        set $mobile_upstream mobile-web;
        proxy_pass http://$mobile_upstream:80;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }

    location /_next/ {
        set $web_upstream web;
        proxy_pass http://$web_upstream:3000;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_buffering off;
        proxy_read_timeout 86400s;
    }

    location / {
        set $web_upstream web;
        proxy_pass http://$web_upstream:3000;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_buffering off;
        proxy_read_timeout 86400s;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    listen 443 quic;
    listen [::]:443 quic;
    http2 on;
    http3 on;
    server_name ${SYNAPSE_MOBILE_SHORT_DOMAIN} ${SYNAPSE_MOBILE_DOMAIN};

