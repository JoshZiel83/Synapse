map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

# ─── Public rate limiting (Ring 0) — docs/logging-refactor/04-operations.md ──
# Bounds unauthenticated flood on the two api-facing public locations. The
# thresholds are GENEROUS: a normal page load or chat session never reaches
# them; only abnormal volume is shaped. Static assets, `/`, `/_next/*`, ACME and
# the registry vhost are deliberately NOT limited (that is what keeps the
# "normal users never notice" promise).
#
# Client key ($synapse_client_key): IPv4 by full address; IPv6 collapsed to the
# /64 its whole allocation lives in, so one /64 is one client instead of 2^64
# free identities. The /64 is computed from the address STRUCTURE by njs
# (ratelimit.js) so it handles compressed forms (::1, fe80::1, 2001:db8::1) that
# a textual regex silently gets wrong — adjudication-2 R4. njs is already loaded
# here for the CDT deltas (cdt.js). The http-profile edge (public-http.conf.
# template, stock nginx without njs) keys per-address instead — see that file.
js_import synapse_ratelimit from /etc/nginx/ratelimit.js;
js_set $synapse_client_key synapse_ratelimit.clientKey;
limit_req_zone  $synapse_client_key zone=synapse_api_req:10m rate=50r/s;
limit_req_zone  $synapse_client_key zone=synapse_ws_req:10m  rate=10r/s;
limit_conn_zone $synapse_client_key zone=synapse_ws_conn:10m;
# 429, not the nginx default 503: the condition is per-client volume and a client
# that can read the status can back off; 503 is indistinguishable from a backend
# outage. warn, not the default error: these lines are the tuning signal, and the
# image symlinks error.log to /dev/stderr (so `docker logs synapse-nginx`).
limit_req_status 429;
limit_conn_status 429;
limit_req_log_level warn;
limit_conn_log_level warn;

# ─── Edge-owned compression (Next sets compress:false) ──────────────────────
# brotli + zstd on-the-fly for proxied DYNAMIC responses (SSR HTML, RSC, API),
# *_static for precompressed /_next/static, gzip as the universal fallback.
# Module load order (Dockerfile.nginx) makes the body-filter preference
# brotli > zstd > gzip. (text/html is always compressed implicitly.)
brotli on;
brotli_comp_level 5;
brotli_static on;
brotli_types text/plain text/css text/xml application/json application/javascript text/javascript application/xml application/rss+xml application/atom+xml image/svg+xml application/manifest+json application/wasm font/ttf font/otf;
zstd on;
zstd_comp_level 8;
zstd_min_length 256;
zstd_static on;
zstd_types text/plain text/css text/xml application/json application/javascript text/javascript application/xml application/rss+xml application/atom+xml image/svg+xml application/manifest+json application/wasm font/ttf font/otf;
gzip on;
gzip_vary on;
gzip_proxied any;
gzip_comp_level 5;
gzip_min_length 256;
gzip_types text/plain text/css text/xml application/json application/javascript text/javascript application/xml application/rss+xml application/atom+xml image/svg+xml application/manifest+json application/wasm font/ttf font/otf;

# ─── Performance ────────────────────────────────────────────────────────────
# (sendfile/keepalive_timeout are already set by the base nginx.conf http{}.)
tcp_nopush on;
tcp_nodelay on;
quic_gso on;

# child locations that add their own add_header (the CDT static block) would
# otherwise DROP server-level HSTS/Alt-Svc/Reporting/NEL; merge appends instead.
add_header_inherit merge;

# ─── RFC 9842 Compression Dictionary Transport ──────────────────────────────
# cdt-generated.conf (baked at build by gen-cdt.sh) defines $cdt_dict_ok (1 when
# the client advertises THIS build's dictionary) + $cdt_dict_url (its URL).
include /etc/nginx/cdt-generated.conf;
js_import cdt from /etc/nginx/cdt.js;
# The Link: rel=compression-dictionary header value (empty -> add_header skipped).
map $cdt_dict_url $cdt_link {
    default "";
    "~.+" "<$cdt_dict_url>; rel=\"compression-dictionary\"";
}

# NOTE: no static `upstream {}` blocks for api/web/mobile-web. An upstream block
# (or a literal proxy_pass hostname) resolves the container name ONCE at config
# load, so recreating a backend (it gets a new docker IP) strands nginx on the
# stale IP → permanent 502 until nginx reloads. Instead each location below uses a
# `set $var ...; proxy_pass http://$var:port;` form, which makes nginx re-resolve
# via docker's embedded DNS (127.0.0.11) on a timer (the resolver `valid=` TTL
# below) — NO reload needed. A backend recreate may still 502 briefly, at most
# until that TTL expires, instead of forever. (Same pattern the registry vhost
# already uses for verdaccio.)

server {
    listen 80;
    listen [::]:80;
    server_name ${SYNAPSE_PUBLIC_DOMAIN} ${SYNAPSE_WWW_DOMAIN} ${SYNAPSE_MOBILE_SHORT_DOMAIN} ${SYNAPSE_MOBILE_DOMAIN} ${SYNAPSE_REGISTRY_DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
        try_files $uri =404;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    listen 443 quic reuseport;
    listen [::]:443 quic reuseport;
    http2 on;
    http3 on;
    server_name ${SYNAPSE_PUBLIC_DOMAIN} ${SYNAPSE_WWW_DOMAIN};

    ssl_certificate /etc/letsencrypt/live/${LETSENCRYPT_CERT_NAME}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${LETSENCRYPT_CERT_NAME}/privkey.pem;
    ssl_trusted_certificate /etc/letsencrypt/live/${LETSENCRYPT_CERT_NAME}/chain.pem;
    ssl_session_cache shared:SynapseSSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    quic_retry on;
    resolver 127.0.0.11 valid=30s ipv6=off;
    resolver_timeout 5s;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header Alt-Svc 'h3=":443"; ma=86400' always;

    # --- Browser auto-reporting (W3C Reporting API + NEL) -> POST /api/v1/reports
    # Same-origin endpoint (proxied below under /api/), so no CORS preflight is
    # needed. NEL still requires the v0 Report-To group today; Reporting-Endpoints
    # (v1) routes crash/deprecation/intervention to the "default" group.
    # success_fraction is tiny to bound volume; HTTPS-only; Chromium-only in
    # practice. See docs/logging-refactor/06-...md §2.
    # IMPORTANT (add_header inheritance footgun): every location in this block is
    # currently add_header-free, so these server-level headers are inherited into
    # all responses. If any location here later adds its own add_header (e.g. a
    # serve-stale `Cache-Status`), you MUST add `add_header_inherit merge;`
    # (nginx >= 1.29.3) at server/http level — otherwise nginx silently DROPS all
    # inherited add_header on that location and these policy headers vanish there.
    # CSP reporting is intentionally NOT enabled yet (needs a policy baseline);
    # the routing above is ready for Content-Security-Policy-Report-Only with
    # `report-to default; report-uri /api/v1/reports` once the team defines it.
    add_header Reporting-Endpoints 'default="/api/v1/reports"' always;
    add_header Report-To '{"group":"nel","max_age":31556952,"endpoints":[{"url":"/api/v1/reports"}]}' always;
    add_header NEL '{"report_to":"nel","max_age":2592000,"success_fraction":0.01,"failure_fraction":1.0}' always;

    client_max_body_size 25m;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $host;
    # Trace trust boundary (Ring 0 -> 1, docs/trace-propagation-policy.md):
    # strip vendor/trust-carrying trace headers at the public edge; an empty
    # proxy_set_header value means the header is NOT passed upstream.
    # `traceparent` is deliberately KEPT (the browser trace bridge needs it;
    # the api validates it at extract and treats its flags as advisory — the
    # api sampler owns the FORCE/ERASE defense, this strip is vendor-state
    # hygiene). proxy_set_header does NOT inherit into a location that
    # declares its own, so every such location below re-declares this trio.
    proxy_set_header tracestate "";
    proxy_set_header baggage "";
    proxy_set_header sentry-trace "";
    # Ring-0 ingress marker — nginx OWNS this header. proxy_set_header REPLACES
    # any client-supplied copy (single or repeated, probe-proven), so its
    # presence upstream means exactly "arrived through the public edge". The api
    # selects its span attribute synapse.trace.ingress=public from it. It grants
    # NOTHING: never an authn/authz/rate-limit-exemption input, never echoed.
    proxy_set_header x-synapse-trace-ingress "public";

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
        try_files $uri =404;
    }

    location ~ /\.(?!well-known/acme-challenge/) {
        return 404;
    }

    location /api/ {
        set $api_upstream api;
        # 200 requests instantly, then 50/s sustained, per client (zone at the
        # top of this file). nodelay: a burst passes or 429s, never queued.
        limit_req zone=synapse_api_req burst=200 nodelay;
        proxy_pass http://$api_upstream:3001;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }

    location /ws {
        set $api_upstream api;
        # Upgrades are cheap to bound — one request per connection.
        limit_req zone=synapse_ws_req burst=50 nodelay;
        # CONCURRENT sessions per client: a WS connection holds its slot for the
        # whole connection lifetime (hours), so this counts sessions, not
        # traffic. 128 covers many tabs plus several daemons behind one NAT; a
        # large corporate/carrier-grade NAT is the case that needs it raised.
        limit_conn synapse_ws_conn 128;
        proxy_pass http://$api_upstream:3001;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        # Ring-0 strip + ingress marker re-declared: this location's own
        # proxy_set_header kills server-level inheritance (traceparent still
        # passes; the marker still OVERRIDES any client copy).
        proxy_set_header tracestate "";
        proxy_set_header baggage "";
        proxy_set_header sentry-trace "";
        proxy_set_header x-synapse-trace-ingress "public";
        proxy_read_timeout 86400s;
    }

    location /mobile/ {
        set $mobile_upstream mobile-web;
        proxy_pass http://$mobile_upstream:80;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }

    # /_next/static: served from DISK by nginx (precompressed br/zst/gz + RFC
    # 9842 dcb/dcz deltas), NOT proxied. More specific than /_next/ so it wins.
    # The njs handler serves a dcb/dcz delta when the client advertises this
    # build's dictionary + accepts the coding + the variant exists; else it
    # internal-redirects to @plain_static (which keeps *_static fallback).
    location /_next/static/ {
        js_content cdt.serve;
    }
    location @plain_static {
        internal;
        root /usr/share/nginx/web;
        brotli_static on;
        zstd_static on;
        gzip_static on;
        gzip_vary on;   # core emits "Vary: Accept-Encoding"; we add the CDT token.
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header Vary "Available-Dictionary" always;
    }
    # The shared compression dictionary, declared usable for /_next/static/*.
    # Served precompressed (gen-cdt emits .br/.zst/.gz next to it) so the one-time
    # ~1MB dictionary fetch is small. Varies only on Accept-Encoding (core).
    location /_next/cdt-dict/ {
        root /usr/share/nginx/web;
        brotli_static on;
        zstd_static on;
        gzip_static on;
        gzip_vary on;
        add_header Use-As-Dictionary 'match="/_next/static/*", match-dest=("script" "style")' always;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }

    # Everything else under /_next/ (image optimizer, data) is proxied to Next.
    location /_next/ {
        set $web_upstream web;
        proxy_pass http://$web_upstream:3000;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        # Ring-0 strip + ingress marker re-declared: this location's own
        # proxy_set_header kills server-level inheritance (traceparent still
        # passes; the marker still OVERRIDES any client copy).
        proxy_set_header tracestate "";
        proxy_set_header baggage "";
        proxy_set_header sentry-trace "";
        proxy_set_header x-synapse-trace-ingress "public";
        proxy_buffering off;
        proxy_read_timeout 86400s;
    }

    location / {
        set $web_upstream web;
        proxy_pass http://$web_upstream:3000;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        # Ring-0 strip + ingress marker re-declared: this location's own
        # proxy_set_header kills server-level inheritance (traceparent still
        # passes; the marker still OVERRIDES any client copy).
        proxy_set_header tracestate "";
        proxy_set_header baggage "";
        proxy_set_header sentry-trace "";
        proxy_set_header x-synapse-trace-ingress "public";
        proxy_buffering off;
        proxy_read_timeout 86400s;
        # Advertise the compression dictionary so browsers idle-fetch it (CDT).
        add_header Link $cdt_link always;
    }
}

