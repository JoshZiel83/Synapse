map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

# No static `upstream {}` blocks: each location resolves its backend via docker's
# embedded DNS (set $var + resolver below) on the resolver `valid=` TTL, so a
# rebuilt api/web/mobile-web container (new IP) is picked up without an nginx
# reload (a brief 502 is possible until the TTL expires, never a permanent one).
# A static upstream/literal hostname would pin the IP at config-load and 502 until
# reload after a backend recreate.

server {
    listen 80;
    listen [::]:80;
    server_name _;

    resolver 127.0.0.11 valid=30s ipv6=off;
    resolver_timeout 5s;

    client_max_body_size 25m;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $host;

    location ~ /\.(?!well-known/acme-challenge/) {
        return 404;
    }

    location /api/ {
        set $api_upstream api;
        proxy_pass http://$api_upstream:3001;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }

    location /ws {
        set $api_upstream api;
        proxy_pass http://$api_upstream:3001;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 86400s;
    }

    location /mobile/ {
        set $mobile_upstream mobile-web;
        proxy_pass http://$mobile_upstream:80;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }

    location /_next/ {
        set $web_upstream web;
        proxy_pass http://$web_upstream:3000;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_buffering off;
        proxy_read_timeout 86400s;
    }

    location / {
        set $web_upstream web;
        proxy_pass http://$web_upstream:3000;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_buffering off;
        proxy_read_timeout 86400s;
    }
}
