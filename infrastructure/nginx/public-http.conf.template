map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

# ─── Public rate limiting (Ring 0) — docs/logging-refactor/04-operations.md ──
# Bounds unauthenticated flood on the two api-facing public locations, GENEROUS
# by design (a normal page load / chat session never trips them). Same zone
# names, rates, burst and 429/warn posture as the TLS edge (public.conf.template)
# — the two run in SEPARATE containers so the names cannot collide.
#
# WEAKER IPv6 BOUND (adjudication-2 R4): this http profile runs STOCK nginx:alpine
# which does not load the njs module in the main context, so it cannot run the
# ratelimit.js /64 collapse. It keys on $binary_remote_addr — per FULL address
# for both IPv4 and IPv6. A client with a whole IPv6 /64 therefore still gets one
# bucket per address here. This profile is meant to sit BEHIND a TLS terminator
# (server_name _, port 80); if it is ever exposed directly to IPv6 clients at
# scale, front it with the TLS edge (public.conf.template collapses to /64) or
# load njs + wire js_set $synapse_client_key as that template does.
#
# BEHIND A TERMINATOR THE KEY IS THE TERMINATOR, NOT THE CLIENT: with a proxy in
# front, $binary_remote_addr is the terminator's own peer address, so every
# client collapses into ONE bucket and these zones degrade to a single GLOBAL
# 50 r/s (api) / 10 r/s (ws) cap — aggregate legitimate load then self-429s. To
# restore per-client keying, and ONLY behind a terminator you trust (never on
# direct exposure, where XFF is client-spoofable), add real_ip so the key is the
# forwarded client address:
#   set_real_ip_from <terminator CIDR>; real_ip_header X-Forwarded-For;
#   real_ip_recursive on;
# The TLS edge (public.conf.template) is not affected: it terminates directly, so
# there its $remote_addr already is the real client.
limit_req_zone  $binary_remote_addr zone=synapse_api_req:10m rate=50r/s;
limit_req_zone  $binary_remote_addr zone=synapse_ws_req:10m  rate=10r/s;
limit_conn_zone $binary_remote_addr zone=synapse_ws_conn:10m;
# 429, not the default 503 (a client can read it and back off; 503 reads as a
# backend outage). warn: these lines are the tuning signal.
limit_req_status 429;
limit_conn_status 429;
limit_req_log_level warn;
limit_conn_log_level warn;

# Next.js now sets compress:false (the edge owns compression). This http-profile
# vhost runs stock nginx (no brotli/zstd module), so enable gzip here or all
# proxied responses would ship uncompressed. (The tls vhost adds brotli + zstd.)
gzip on;
gzip_vary on;
gzip_proxied any;
gzip_comp_level 5;
gzip_min_length 256;
gzip_types text/plain text/css text/xml application/json application/javascript text/javascript application/xml application/rss+xml application/atom+xml image/svg+xml application/manifest+json application/wasm font/ttf font/otf;

# No static `upstream {}` blocks: each location resolves its backend via docker's
# embedded DNS (set $var + resolver below) on the resolver `valid=` TTL, so a
# rebuilt api/web/mobile-web container (new IP) is picked up without an nginx
# reload (a brief 502 is possible until the TTL expires, never a permanent one).
# A static upstream/literal hostname would pin the IP at config-load and 502 until
# reload after a backend recreate.

server {
    listen 80;
    listen [::]:80;
    server_name _;

    resolver 127.0.0.11 valid=30s ipv6=off;
    resolver_timeout 5s;

    client_max_body_size 25m;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $host;
    # Trace trust boundary (Ring 0 -> 1, docs/trace-propagation-policy.md):
    # strip vendor/trust-carrying trace headers at the public edge; an empty
    # proxy_set_header value means the header is NOT passed upstream.
    # `traceparent` is deliberately KEPT (the browser trace bridge needs it;
    # the api validates it at extract and treats its flags as advisory — the
    # api sampler owns the FORCE/ERASE defense, this strip is vendor-state
    # hygiene). proxy_set_header does NOT inherit into a location that
    # declares its own, so every such location below re-declares this trio.
    proxy_set_header tracestate "";
    proxy_set_header baggage "";
    proxy_set_header sentry-trace "";
    # Ring-0 ingress marker — nginx OWNS this header. proxy_set_header REPLACES
    # any client-supplied copy (single or repeated), so its presence upstream
    # means exactly "arrived through the public edge". The api selects its span
    # attribute synapse.trace.ingress=public from it. It grants NOTHING: never an
    # authn/authz/rate-limit-exemption input, never echoed to the client.
    proxy_set_header x-synapse-trace-ingress "public";

    location ~ /\.(?!well-known/acme-challenge/) {
        return 404;
    }

    location /api/ {
        set $api_upstream api;
        # 200 requests instantly, then 50/s sustained, per client. nodelay: a
        # burst passes or 429s, never queued.
        limit_req zone=synapse_api_req burst=200 nodelay;
        proxy_pass http://$api_upstream:3001;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }

    location /ws {
        set $api_upstream api;
        # Upgrades are cheap to bound — one request per connection.
        limit_req zone=synapse_ws_req burst=50 nodelay;
        # CONCURRENT sessions per client: a WS connection holds its slot for its
        # whole lifetime (hours), so this counts sessions, not traffic. 128
        # covers many tabs plus daemons behind one NAT; raise it for a large NAT.
        limit_conn synapse_ws_conn 128;
        proxy_pass http://$api_upstream:3001;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        # Ring-0 strip + ingress marker re-declared: this location's own
        # proxy_set_header kills server-level inheritance (traceparent still
        # passes; the marker still OVERRIDES any client copy).
        proxy_set_header tracestate "";
        proxy_set_header baggage "";
        proxy_set_header sentry-trace "";
        proxy_set_header x-synapse-trace-ingress "public";
        proxy_read_timeout 86400s;
    }

    location /mobile/ {
        set $mobile_upstream mobile-web;
        proxy_pass http://$mobile_upstream:80;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }

    location /_next/ {
        set $web_upstream web;
        proxy_pass http://$web_upstream:3000;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        # Ring-0 strip + ingress marker re-declared: this location's own
        # proxy_set_header kills server-level inheritance (traceparent still
        # passes; the marker still OVERRIDES any client copy).
        proxy_set_header tracestate "";
        proxy_set_header baggage "";
        proxy_set_header sentry-trace "";
        proxy_set_header x-synapse-trace-ingress "public";
        proxy_buffering off;
        proxy_read_timeout 86400s;
    }

    location / {
        set $web_upstream web;
        proxy_pass http://$web_upstream:3000;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        # Ring-0 strip + ingress marker re-declared: this location's own
        # proxy_set_header kills server-level inheritance (traceparent still
        # passes; the marker still OVERRIDES any client copy).
        proxy_set_header tracestate "";
        proxy_set_header baggage "";
        proxy_set_header sentry-trace "";
        proxy_set_header x-synapse-trace-ingress "public";
        proxy_buffering off;
        proxy_read_timeout 86400s;
    }
}
