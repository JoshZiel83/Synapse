FROM node:20-bookworm-slim AS builder
WORKDIR /app
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates git curl \
  && rm -rf /var/lib/apt/lists/*
RUN git init
RUN npm config set registry https://registry.npmmirror.com \
  && npm config set fetch-retries 5 \
  && npm config set fetch-retry-mintimeout 20000 \
  && npm config set fetch-retry-maxtimeout 120000

# package-lock.json validates EVERY workspace against an on-disk
# package.json, so all 13 workspace manifests must be present before
# `npm ci` — even the ones this image does not build (the 6 platform
# sidecar bundles + device-sdk + remote-agent-daemon + web-next).
COPY package.json package-lock.json ./
# Dependency patches + the applier, ABOVE the install layer so that layer's cache
# key tracks them. `npm ci` below runs --ignore-scripts, so the root postinstall
# never fires here: patches are applied by the explicit RUN after the install.
COPY patches/ patches/
COPY scripts/apply-patches.mjs scripts/apply-patches.mjs
COPY packages/device-protocol/package.json packages/device-protocol/
COPY packages/shared/package.json packages/shared/
COPY packages/device-runtime/package.json packages/device-runtime/
COPY packages/device-sdk/package.json packages/device-sdk/
COPY packages/device-runtime-bundles-linux-x64/package.json packages/device-runtime-bundles-linux-x64/
COPY packages/device-runtime-bundles-linux-arm64/package.json packages/device-runtime-bundles-linux-arm64/
COPY packages/device-runtime-bundles-darwin-x64/package.json packages/device-runtime-bundles-darwin-x64/
COPY packages/device-runtime-bundles-darwin-arm64/package.json packages/device-runtime-bundles-darwin-arm64/
COPY packages/device-runtime-bundles-win32-x64/package.json packages/device-runtime-bundles-win32-x64/
COPY packages/device-runtime-bundles-win32-arm64/package.json packages/device-runtime-bundles-win32-arm64/
COPY packages/api/package.json packages/api/
COPY packages/remote-agent-daemon/package.json packages/remote-agent-daemon/
COPY packages/web-next/package.json packages/web-next/

# Install the api build chain only. --ignore-scripts is safe for the native
# prebuilts this image uses: sharp ships prebuilt @img binaries and bcryptjs is
# pure JS (proven by the `require('sharp')` assertion below). It ALSO suppresses
# the root `postinstall` (`node scripts/apply-patches.mjs`), which is why the patch step is an
# explicit RUN after this layer rather than a side effect of the install.
RUN npm ci --legacy-peer-deps --ignore-scripts \
      --workspace=packages/device-protocol \
      --workspace=packages/shared \
      --workspace=packages/device-runtime \
      --workspace=packages/api \
      --include-workspace-root

# --ignore-scripts skipped the root postinstall, so apply patches/ explicitly and
# PROVE they stuck. NO --require-all: this image installs only a workspace subset,
# so a patch whose target package is outside that subset is a legitimate skip, not
# a failure (adjudication R5) — but any patch whose target IS present must apply
# and verify, or the build fails. This RUN is the ONLY assertion that sees the
# artifact; scripts/verify-boundary.sh only ever sees the host tree.
RUN node scripts/apply-patches.mjs

COPY tsconfig.base.json ./
COPY .setup/ .setup/

# Source for the api dependency chain, copied in topological order.
COPY packages/device-protocol/ packages/device-protocol/
COPY packages/shared/ packages/shared/
COPY packages/device-runtime/ packages/device-runtime/
COPY packages/api/ packages/api/

# Build strictly in dependency order. Each package resolves its @synapse/*
# deps through node_modules symlinks pointing at the PRIOR package's dist,
# so the order is load-bearing (the packages have no tsc project
# references in their build configs). The package `build` scripts each run
# a `prebuild` that wipes dist, and use tsconfig.build.json (sourceMap
# off) so no .map artifacts ship.
RUN npm run build -w packages/device-protocol \
  && npm run build -w packages/shared \
  && npm run build -w packages/device-runtime \
  && npm run build -w packages/api -- --sourceMap false --declarationMap false

RUN cp packages/api/src/infrastructure/database/schema.sql packages/api/dist/infrastructure/database/schema.sql
# NOTE: builtin-plugins carries NO non-TS assets anymore — the brand SVGs were
# replaced by React icon components (icons refactor), and the runtime imports only
# .ts modules (categories.ts / index.ts), which tsc emits to dist/. If a non-TS
# asset dir is ever added under src/ again, mirror it to dist/ here.

# OCR is NOT bundled in the api image (zero-OCR-api): the api runs no OCR
# engine and no tessdata is baked here. OCR runs out-of-process in a sidecar
# (sidecars/tesseract, sidecars/ppocr) reached over HTTP, selected by
# OCR_PROVIDER + the sidecar URL env. See docs/ocr-abstraction-layer-plan-2026-07-01.md.

# Embedding is NOT bundled in the api image (zero-embedding-api): the api runs no
# embedding engine and no model is baked here. Embedding runs out-of-process — the
# local bge-m3 sidecar (sidecars/embed) or a cloud vendor — reached over HTTP,
# selected by EMBEDDING_PROVIDER + the provider env. See
# docs/embedding-abstraction-layer-plan-2026-07-02.md.

# --- BUILD-TIME ASSERTION: native bindings load (no silent runtime ENOENT) ---
# --ignore-scripts skipped postinstall; prove the prebuilt native modules the API
# actually uses load before shipping. (onnxruntime is gone with the in-process
# embedder; sharp is still used for image processing.)
RUN node -e "require('sharp'); console.log('native deps OK')"

# ── Rust builder: compile the fs-helper sidecar (supervisor-side CAS) ─────────
# The API process ITSELF runs synapse-device-fs-helper for ALL sandbox CAS work
# (materialize / scan / 3-way merge) in provisionSandbox — BEFORE the backend is
# even selected — so BOTH the `local` and `docker` backends need it baked into
# the API image (topology A). Self-contained: built from sidecars/ in the build
# context; .dockerignore excludes **/target so the host's build outputs never
# enter the context and `--locked` (Cargo.lock present) stays reproducible.
# Mirrors the cloud-sandbox image's fs-helper stage.
FROM rust:1-bookworm AS fs-helper-builder
WORKDIR /build
COPY sidecars/fs-helper/ sidecars/fs-helper/
RUN cd sidecars/fs-helper && cargo build --release --locked

FROM node:20-bookworm-slim
WORKDIR /app
# Docker CLI (client only) for the DooD sandbox backend — it talks to the
# host daemon via the mounted /var/run/docker.sock. Static binary; no daemon.
# bubblewrap + ripgrep are for the LOCAL sandbox backend, whose device-runtime
# runs as a same-host child INSIDE this container: bwrap is the --cmd-sandbox
# jail (absent → commandline fail-closes off), ripgrep backs live fs_search
# (absent → fs_search ENOENT-throws). Both are inert for the docker backend
# (no co-located child) — only image size. Explicitly installed, so they
# survive the `apt-get purge curl` / autoremove below.
# ffmpeg is the audio transcoder the api spawns in-process for IM voice notes
# (infrastructure/media/transcode.ts → OGG/Opus mono). Callers gate supportsVoice
# on ffmpegAvailable(), so absent → outbound voice silently degrades to a document
# attachment. The ASR sidecars bake their own ffmpeg; the api needs its own here.
ARG DOCKER_CLI_VERSION=27.5.1
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates curl bubblewrap ripgrep ffmpeg \
  && curl -fsSL "https://download.docker.com/linux/static/stable/x86_64/docker-${DOCKER_CLI_VERSION}.tgz" \
       -o /tmp/docker.tgz \
  && tar -xzf /tmp/docker.tgz -C /tmp \
  && mv /tmp/docker/docker /usr/local/bin/docker \
  && chmod +x /usr/local/bin/docker \
  && rm -rf /tmp/docker /tmp/docker.tgz \
  && apt-get purge -y curl \
  && apt-get autoremove -y \
  && rm -rf /var/lib/apt/lists/*
# Carry the whole built tree: node_modules (with @synapse symlinks + native
# binaries) and every package's dist/. dist/index.js resolves
# @synapse/device-protocol + @synapse/device-runtime via these symlinks.
COPY --from=builder /app/ ./
# fs-helper Rust sidecar — supervisor-side CAS engine for BOTH sandbox backends.
# Placed at the path the api resolver climbs to (anchored on materialize.js via
# import.meta.url: dist/modules/sandbox → 6×.. → /app/sidecars/fs-helper, then
# target/release/<bin>) AND pinned via the env var (resolveSidecarPath honors it
# first). Redundant on purpose: env is primary, the on-disk path is the climb
# backstop — keep the two aligned if either moves.
COPY --from=fs-helper-builder \
     /build/sidecars/fs-helper/target/release/synapse-device-fs-helper \
     /app/sidecars/fs-helper/target/release/synapse-device-fs-helper
# The api resolver honors this env first when locating the fs-helper sidecar bin.
ENV SYNAPSE_DEVICE_FS_HELPER_PATH=/app/sidecars/fs-helper/target/release/synapse-device-fs-helper
EXPOSE 3001
# `--import` preloads the OpenTelemetry/Sentry instrumentation before app code so
# the HTTP instrumentation can patch node:http (inbound spans + outbound W3C
# traceparent propagation) under ESM. instrumentation.js is also imported by
# index.js (ESM caches it, so it initializes exactly once).
CMD ["node", "--import", "./packages/api/dist/instrumentation.js", "packages/api/dist/index.js"]
