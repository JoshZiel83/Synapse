FROM node:22-bookworm-slim AS builder
WORKDIR /app
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates git \
  && rm -rf /var/lib/apt/lists/*
RUN git init
RUN npm config set fetch-retries 5 \
  && npm config set fetch-retry-mintimeout 20000 \
  && npm config set fetch-retry-maxtimeout 120000
COPY package.json package-lock.json ./
COPY packages/shared/package.json packages/shared/
COPY packages/api/package.json packages/api/
COPY packages/remote-agent-daemon/package.json packages/remote-agent-daemon/
COPY packages/web-next/package.json packages/web-next/
RUN npm ci --legacy-peer-deps --ignore-scripts \
      --workspace=packages/shared \
      --workspace=packages/remote-agent-daemon \
      --include-workspace-root
COPY tsconfig.base.json ./
COPY packages/shared/ packages/shared/
COPY packages/remote-agent-daemon/ packages/remote-agent-daemon/
RUN npx tsc -b packages/shared --force
RUN npm run build -w packages/remote-agent-daemon

FROM node:22-bookworm-slim
WORKDIR /app
ENV CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
ENV CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS=1
RUN apt-get update \
  && apt-get install -y --no-install-recommends \
       ca-certificates git curl proxychains4 \
  && rm -rf /var/lib/apt/lists/*
RUN npm install -g @anthropic-ai/claude-code @openai/codex \
  && npm cache clean --force
RUN printf '%s\n' \
  'strict_chain' \
  'proxy_dns' \
  'remote_dns_subnet 224' \
  'tcp_read_time_out 15000' \
  'tcp_connect_time_out 8000' \
  '[ProxyList]' \
  'socks5 127.0.0.1 1080' \
  > /etc/proxychains4.conf
COPY --from=builder /app/ ./
# Claude Code refuses to run with --dangerously-skip-permissions under root
# (it prints "cannot be used with root/sudo privileges for security reasons"
# and exits immediately, which we observed as a downstream EPIPE storm
# because the SDK kept writing to the dead subprocess). The daemon's whole
# operating model requires bypassPermissions — Synapse evaluates tool grants
# itself via the reverse-MCP server — so the right move is to run the
# daemon (and the claude/codex children it spawns) as an unprivileged user.
RUN groupadd --system --gid 1100 synapse \
  && useradd --system --uid 1100 --gid 1100 --home /home/synapse --create-home --shell /bin/sh synapse \
  && mkdir -p /home/synapse/.claude /home/synapse/.codex /home/synapse/.synapse/remote-agents \
  && chown -R synapse:synapse /app /home/synapse
USER synapse
ENV HOME=/home/synapse
ENTRYPOINT ["node", "packages/remote-agent-daemon/dist/index.js"]
