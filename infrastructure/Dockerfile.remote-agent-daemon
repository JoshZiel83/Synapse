FROM node:22-bookworm-slim AS builder
WORKDIR /app
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates git \
  && rm -rf /var/lib/apt/lists/*
RUN git init
RUN npm config set fetch-retries 5 \
  && npm config set fetch-retry-mintimeout 20000 \
  && npm config set fetch-retry-maxtimeout 120000
COPY package.json package-lock.json ./
COPY packages/shared/package.json packages/shared/
COPY packages/remote-agent-daemon/package.json packages/remote-agent-daemon/
RUN npm ci --legacy-peer-deps \
      --workspace=packages/shared \
      --workspace=packages/remote-agent-daemon
COPY tsconfig.base.json ./
COPY packages/shared/ packages/shared/
COPY packages/remote-agent-daemon/ packages/remote-agent-daemon/
RUN npx tsc -b packages/shared
RUN npm run build -w packages/remote-agent-daemon

FROM node:22-bookworm-slim
WORKDIR /app
ENV CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
ENV CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS=1
RUN apt-get update \
  && apt-get install -y --no-install-recommends \
       ca-certificates git curl proxychains4 \
  && rm -rf /var/lib/apt/lists/*
RUN npm install -g @anthropic-ai/claude-code @openai/codex \
  && npm cache clean --force
RUN printf '%s\n' \
  'strict_chain' \
  'proxy_dns' \
  'remote_dns_subnet 224' \
  'tcp_read_time_out 15000' \
  'tcp_connect_time_out 8000' \
  '[ProxyList]' \
  'socks5 127.0.0.1 1080' \
  > /etc/proxychains4.conf
COPY --from=builder /app/ ./
ENTRYPOINT ["node", "packages/remote-agent-daemon/dist/index.js"]
