FROM node:20-alpine AS builder
WORKDIR /app
RUN apk add --no-cache git
RUN git init
RUN npm config set registry https://registry.npmmirror.com \
  && npm config set fetch-retries 5 \
  && npm config set fetch-retry-mintimeout 20000 \
  && npm config set fetch-retry-maxtimeout 120000

COPY package.json package-lock.json ./
COPY tsconfig.base.json ./
COPY packages/shared/package.json packages/shared/
COPY packages/api/package.json packages/api/
COPY packages/web-next/package.json packages/web-next/
RUN npm ci --workspace=packages/shared --workspace=packages/api --workspace=packages/web-next

COPY packages/shared/ packages/shared/
RUN npx tsc -b packages/shared

COPY packages/web-next/ packages/web-next/

ARG NEXT_PUBLIC_API_URL=/api/v1
ARG NEXT_PUBLIC_WS_URL
ARG NEXT_PUBLIC_APP_URL
ARG NEXT_PUBLIC_SITE_URL
ARG API_PROXY_ORIGIN=http://api:3001
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}
ENV NEXT_PUBLIC_WS_URL=${NEXT_PUBLIC_WS_URL}
ENV NEXT_PUBLIC_APP_URL=${NEXT_PUBLIC_APP_URL}
ENV NEXT_PUBLIC_SITE_URL=${NEXT_PUBLIC_SITE_URL}
ENV API_PROXY_ORIGIN=${API_PROXY_ORIGIN}

WORKDIR /app/packages/web-next
RUN npm run build

FROM node:20-alpine
WORKDIR /app/packages/web-next
COPY --from=builder /app/node_modules /app/node_modules
COPY --from=builder /app/packages/shared /app/packages/shared
COPY --from=builder /app/packages/web-next/.next ./.next
COPY --from=builder /app/packages/web-next/public ./public
COPY --from=builder /app/packages/web-next/package.json ./package.json
COPY --from=builder /app/packages/web-next/next.config.mjs ./next.config.mjs
EXPOSE 3000
CMD ["node", "/app/node_modules/next/dist/bin/next", "start", "-p", "3000"]
