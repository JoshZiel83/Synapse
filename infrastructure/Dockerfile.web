FROM node:20-alpine AS builder
WORKDIR /app
RUN apk add --no-cache git
RUN git init
RUN npm config set registry https://registry.npmmirror.com \
  && npm config set fetch-retries 5 \
  && npm config set fetch-retry-mintimeout 20000 \
  && npm config set fetch-retry-maxtimeout 120000

COPY package.json package-lock.json ./
COPY tsconfig.base.json ./
# All workspace manifests must exist so `npm ci` can validate the lockfile,
# even though this image only builds device-protocol + shared + web-next.
COPY packages/device-protocol/package.json packages/device-protocol/
COPY packages/shared/package.json packages/shared/
COPY packages/device-runtime/package.json packages/device-runtime/
COPY packages/device-sdk/package.json packages/device-sdk/
COPY packages/device-runtime-bundles-linux-x64/package.json packages/device-runtime-bundles-linux-x64/
COPY packages/device-runtime-bundles-linux-arm64/package.json packages/device-runtime-bundles-linux-arm64/
COPY packages/device-runtime-bundles-darwin-x64/package.json packages/device-runtime-bundles-darwin-x64/
COPY packages/device-runtime-bundles-darwin-arm64/package.json packages/device-runtime-bundles-darwin-arm64/
COPY packages/device-runtime-bundles-win32-x64/package.json packages/device-runtime-bundles-win32-x64/
COPY packages/device-runtime-bundles-win32-arm64/package.json packages/device-runtime-bundles-win32-arm64/
COPY packages/api/package.json packages/api/
COPY packages/remote-agent-daemon/package.json packages/remote-agent-daemon/
COPY packages/web-next/package.json packages/web-next/
RUN npm ci --workspace=packages/device-protocol --workspace=packages/shared --workspace=packages/web-next

# @synapse/shared value-imports @synapse/device-protocol/browser-tools, so
# device-protocol must be built before shared (which web-next consumes).
COPY packages/device-protocol/ packages/device-protocol/
COPY packages/shared/ packages/shared/
RUN npm run build -w packages/device-protocol && npm run build -w packages/shared

COPY packages/web-next/ packages/web-next/

ARG NEXT_PUBLIC_API_URL=/api/v1
ARG NEXT_PUBLIC_WS_URL
ARG NEXT_PUBLIC_APP_URL
ARG NEXT_PUBLIC_SITE_URL
ARG API_PROXY_ORIGIN=http://api:3001
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}
ENV NEXT_PUBLIC_WS_URL=${NEXT_PUBLIC_WS_URL}
ENV NEXT_PUBLIC_APP_URL=${NEXT_PUBLIC_APP_URL}
ENV NEXT_PUBLIC_SITE_URL=${NEXT_PUBLIC_SITE_URL}
ENV API_PROXY_ORIGIN=${API_PROXY_ORIGIN}

WORKDIR /app/packages/web-next
RUN npm run build

FROM node:20-alpine
WORKDIR /app/packages/web-next
COPY --from=builder /app/node_modules /app/node_modules
COPY --from=builder /app/packages/shared /app/packages/shared
# node_modules has a @synapse/device-protocol symlink → packages/device-protocol;
# copy the target so the symlink is not dangling at runtime.
COPY --from=builder /app/packages/device-protocol /app/packages/device-protocol
COPY --from=builder /app/packages/web-next/.next ./.next
COPY --from=builder /app/packages/web-next/public ./public
COPY --from=builder /app/packages/web-next/package.json ./package.json
COPY --from=builder /app/packages/web-next/next.config.mjs ./next.config.mjs
EXPOSE 3000
CMD ["node", "/app/node_modules/next/dist/bin/next", "start", "-p", "3000"]
