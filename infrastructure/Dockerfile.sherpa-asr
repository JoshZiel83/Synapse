# sherpa-onnx SenseVoice ASR sidecar — a sherpa-onnx offline recognizer + ffmpeg
# transcode behind a small FastAPI service. The Synapse api bundles NO speech
# engine (zero-ASR-api); it POSTs audio bytes here over HTTP and gets back text.
# Build context is the repo ROOT:
#   docker build -f infrastructure/Dockerfile.sherpa-asr -t synapse-sherpa-asr .
#
# The default model is SenseVoice-Small int8 (zh/en/ja/ko/yue, ~229 MB). It is
# licensed under the Alibaba FunASR Model License (NOT Apache-2.0) — its LICENSE +
# model name are retained under /app/models/sensevoice for the license's
# attribution requirement. Swap models at build with
#   --build-arg SHERPA_ASR_MODEL_URL=<a same-architecture SenseVoice export .tar.bz2>
# Heavier than the tesseract OCR sidecar (~1–1.5 GB RSS from onnxruntime CPU).

FROM python:3.12-slim

# China mirror for resilient pip installs (matches the other sidecars).
RUN pip config set global.index-url https://pypi.tuna.tsinghua.edu.cn/simple || true

# ffmpeg transcodes arbitrary audio containers → 16 kHz mono PCM (the api ships no
# ffmpeg). curl + bzip2 fetch/extract the model tarball at build.
RUN apt-get update \
  && apt-get install -y --no-install-recommends ffmpeg ca-certificates curl bzip2 \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Bake the ASR model FIRST (before the app code) so this ~1 GB download layer is
# cached across code changes. The tarball extracts to a versioned dir holding both
# model.int8.onnx (~229 MB, what we keep) and the full-precision model.onnx
# (~895 MB, discarded); normalize the int8 model + tokens (+ LICENSE for
# attribution + test_wavs for the CI golden check) into /app/models/sensevoice so
# pipeline.py finds them, then drop the rest. The FunASR Model License requires
# attribution, so a tarball-layout change that drops the LICENSE fails the build.
ARG SHERPA_ASR_MODEL_URL=https://github.com/k2-fsa/sherpa-onnx/releases/download/asr-models/sherpa-onnx-sense-voice-zh-en-ja-ko-yue-2024-07-17.tar.bz2
RUN set -eux; \
  mkdir -p /app/models/sensevoice; \
  curl -fsSL --retry 3 -o /tmp/model.tar.bz2 "${SHERPA_ASR_MODEL_URL}"; \
  tar xjf /tmp/model.tar.bz2 -C /tmp; \
  src="$(dirname "$(find /tmp -name model.int8.onnx | head -1)")"; \
  test -n "${src}" || { echo "FATAL: model.int8.onnx not found in the model tarball"; exit 1; }; \
  cp "${src}/model.int8.onnx" "${src}/tokens.txt" "${src}/LICENSE" /app/models/sensevoice/; \
  cp -r "${src}/test_wavs" /app/models/sensevoice/test_wavs 2>/dev/null || true; \
  rm -rf /tmp/model.tar.bz2 "${src}"; \
  test -s /app/models/sensevoice/model.int8.onnx; \
  test -s /app/models/sensevoice/tokens.txt; \
  test -s /app/models/sensevoice/LICENSE

COPY sidecars/sherpa-asr/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# Shared sidecar tracing module (trace-correctness §4.E) — flat-COPY so
# `_shared` is importable next to serve.py.
COPY sidecars/_shared/ ./_shared/
COPY sidecars/sherpa-asr/ ./

# Non-root runtime user; the model dir is read-only data owned by it.
RUN useradd --create-home --uid 10001 asr && chown -R asr:asr /app
USER asr

ENV PYTHONUNBUFFERED=1 \
    SHERPA_ASR_HOST=0.0.0.0 \
    SHERPA_ASR_PORT=8772 \
    SHERPA_ASR_MODEL_DIR=/app/models/sensevoice \
    SHERPA_ASR_MAX_CONCURRENCY=2 \
    SHERPA_ASR_NUM_THREADS=4

# Fail the build if the baked model can't construct a recognizer (catches a bad
# export / missing files / broken onnxruntime HERE, not on the first request).
RUN python -c "from pipeline import build_recognizer; build_recognizer(); print('sherpa-asr model OK')"

EXPOSE 8772

# The recognizer loads in a few seconds on CPU → modest start_period; readiness
# gates on /healthz.ready (false until serve.py's lifespan warms the model).
HEALTHCHECK --interval=15s --timeout=5s --start-period=40s --retries=10 \
  CMD python -c "import urllib.request,sys,json; sys.exit(0 if json.load(urllib.request.urlopen('http://127.0.0.1:8772/healthz', timeout=3))['ready'] else 1)" || exit 1

CMD ["python", "serve.py"]
