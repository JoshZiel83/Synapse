{
  // ---------------------------------------------------------------------------
  // Synapse config-file JSON Schema mappings — give editors autocomplete +
  // inline validation on our config files.
  //
  //   /schemas/*.schema.json         GENERATED from Zod by `npm run schema:gen`
  //                                  (single source of truth; do not hand-edit).
  //   /schemas/vendor/*.schema.json  VENDORED third-party schemas (see that dir's
  //                                  README for provenance + refresh).
  //
  // YAML mappings require the `redhat.vscode-yaml` extension (.vscode/extensions.json
  // recommends it). Note the DIRECTION difference:
  //   - yaml.schemas is { schema -> file glob(s) }
  //   - json.schemas is [ { fileMatch, url } ]  (the reverse)
  //
  // All schema paths are LOCAL and workspace-root-relative on purpose — no remote
  // URLs, so validation works offline and behind restricted networks.
  // ---------------------------------------------------------------------------
  "yaml.schemas": {
    "./schemas/model-groups.schema.json": "packages/api/config/model-groups.yaml*",
    "./schemas/vendor/compose-spec.schema.json": [
      "docker-compose*.yml",
      "**/docker-compose*.yaml"
    ]
  },

  // json.schemas is [ { fileMatch, url } ] — the reverse direction of yaml.schemas.
  // fileMatch is intentionally the config filename(s) only (not the *.schema.json
  // itself), so the schema is applied to the operator's content-storage config
  // wherever they place it, and to the committed example.
  "json.schemas": [
    {
      "fileMatch": [
        "**/content-storage-backends.json",
        "**/content-storage-backends.example.json"
      ],
      "url": "./schemas/content-storage-backends.schema.json"
    },
    {
      "fileMatch": ["**/runtime-tuning.json", "**/runtime-tuning.example.json"],
      "url": "./schemas/runtime-tuning.schema.json"
    },
    {
      "fileMatch": [
        "**/bundles/manifest.json",
        "**/bundles/manifest.production.template.json"
      ],
      "url": "./schemas/toolchain-manifest.schema.json"
    },
    {
      "fileMatch": ["**/cli-catalog/cli-prereq-overlay.json"],
      "url": "./schemas/cli-prereq-overlay.schema.json"
    }
  ]
}
