# Map the @synapse scope to the private registry. ${NPM_REGISTRY} is
# interpolated from the environment at npm-invocation time (export it via
# `set -a && source infra/verdaccio/.env && set +a`), so the registry
# host is NOT hardcoded into the repo.
#
# NOTE: this project-level .npmrc affects INSTALL/RESOLVE for @synapse/*
# in this repo. It is NOT a publish guard: publish commands must still
# pass --registry="$NPM_REGISTRY" explicitly (see the plan / scripts),
# because the prepublishOnly lifecycle does not see this scope mapping
# as npm_config_registry.
@synapse:registry=${NPM_REGISTRY}
