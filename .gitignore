.idea
node_modules/
dist/
.next/
.env
.env.local
.env.*.local
# Ignore all other dotenv variants (e.g. .env.production, .env.staging)…
.env.*
# …but keep example templates trackable, including nested ones.
!.env.example
!**/.env.example
*.log
.DS_Store
coverage/
artifacts/

.claude/*
# ...but DO track the bundled impeccable design skill.
!.claude/skills/
.claude/skills/*
!.claude/skills/impeccable/
CLAUDE.md
TARGET.md

.cert/*
storage/
# ...but NOT the source module that happens to be named "storage".
!packages/api/src/infrastructure/storage/
infrastructure/nginx.conf

# Local dev / test scripts that may contain secrets
scripts/*.local.mjs
scripts/*.local.js
packages/*/scripts/*.local.mjs
packages/*/scripts/*.local.js

# Build caches
*.tsbuildinfo

# Relay agent
relay/synapse-relay
relay/synapse-relay-*
relay/config.yaml
relay/cmd/synapse-relay-gui/frontend/node_modules/
relay/cmd/synapse-relay-gui/frontend/dist/*
# Stub kept so `//go:embed all:frontend/dist` resolves before `wails build`
# has populated the real artifacts (lets `go test ./...` pass cleanly).
!relay/cmd/synapse-relay-gui/frontend/dist/
!relay/cmd/synapse-relay-gui/frontend/dist/index.html
relay/cmd/synapse-relay-gui/frontend/src/lib/wailsjs/
relay/cmd/synapse-relay-gui/frontend/wailsjs/
relay/cmd/synapse-relay-gui/frontend/package.json.md5
relay/cmd/synapse-relay-gui/build/
relay/internal/nodebundle/assets/node/
relay/internal/chromemcpbundle/assets/p/
relay/internal/commandlinebundle/assets/bin/
relay/internal/commandlinebundle/assets/ff/
relay/internal/commandlinebundle/assets/git/
relay/internal/commandlinebundle/assets/nm/
relay/internal/commandlinebundle/assets/py/
relay/internal/commandlinebundle/assets/providers/
relay/internal/commandlinebundle/assets/sp/

# Local reference checkouts
.refer/
.workbuddy/
.synapse-relay-vms/

# Verdaccio private-registry credentials (commit only the *.example files)
infra/verdaccio/.env
infra/verdaccio/htpasswd
