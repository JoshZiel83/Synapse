# === mcp-plugins sidecars ===
# Optional, opt-in builtin MCP plugins. These are overseas-only integrations:
# leave them disabled unless your deployment is meant to reach the relevant
# external services. Each plugin is only SEEDED (surfaced as installable) when
# its enable flag is set; the sidecar-backed ones ALSO require their *_MCP_URL.

# Firecrawl — hosted remote MCP (no sidecar). The fc- API key is supplied
# per-install, so no deploy-level credential is needed here. Set to 1 (or true)
# to surface the plugin.
MCP_ENABLE_FIRECRAWL=

# Notion — proxies the optional notion-mcp sidecar (compose `notion` profile).
# Per-request Notion integration tokens are supplied per-install. Enable BOTH
# the flag and the URL, then start the sidecar:
#   docker compose --profile production --profile notion up -d --build notion-mcp api
MCP_ENABLE_NOTION=
NOTION_MCP_URL=http://notion-mcp:8766/mcp/

# 小红书 (Xiaohongshu) — proxies the optional xhs-mcp sidecar (compose `xhs`
# profile). Heavy: runs a headless-browser backend per tenant. Enable BOTH the
# flag and the URL, then start the sidecar:
#   docker compose --profile production --profile xhs up -d --build xhs-mcp api
MCP_ENABLE_XHS=
XHS_MCP_URL=http://xhs-mcp:8769/mcp/
# Max concurrent per-tenant 小红书 browser backends in the sidecar (LRU-evicted).
XHS_MAX_TENANT_BACKENDS=3
# Idle TTL (seconds) before an inactive tenant backend is torn down.
XHS_BACKEND_IDLE_TTL_SECONDS=1800
# Comma-separated allowlist of storage hosts the sidecar may reach for media
# upload (SSRF guard). Empty => publish-with-media disabled.
XHS_STORAGE_HOSTS=

# Bilibili (哔哩哔哩) — proxies the optional bilibili-mcp sidecar (compose
# `bilibili` profile). LIB-WRAP over the GPL-3.0 bilibili-api library; the web
# Cookie (SESSDATA + bili_jct) is supplied per-install. Write tools are opt-in
# per install and per-account rate-limited. Enable BOTH the flag and the URL,
# then start the sidecar:
#   docker compose --profile production --profile bilibili up -d --build bilibili-mcp api
MCP_ENABLE_BILIBILI=
BILIBILI_MCP_URL=http://bilibili-mcp:8768/mcp/

# === OCR ===
# The api bundles NO OCR engine; it reads env only and calls an out-of-process
# provider. OCR_PROVIDER selects the engine: `none` (disable image OCR), or a
# sidecar (`tesseract` | `ppocr`). IMAGE_FALLBACK_PROVIDER is a deprecated alias
# for OCR_PROVIDER. The compose default keeps OCR on via the tesseract sidecar
# (shipped in the `production` profile), so you usually leave these unset.
#
# tesseract sidecar (native tesseract-ocr). Selected + reached by:
#OCR_PROVIDER=tesseract
#TESSERACT_URL=http://tesseract-ocr:8771/
# Space/`+`-joined tesseract language codes (must match the sidecar's tessdata).
#TESSERACT_LANGS=chi_sim+chi_tra+eng+jpn
#
# PP-OCRv6 sidecar (compose `ppocr` profile). To use PP-OCRv6 instead of
# tesseract, set the provider + URL and start the profile:
#   docker compose --profile production --profile ppocr up -d --build ppocr api
#OCR_PROVIDER=ppocr
#PPOCR_URL=http://ppocr:8770/
# Recognition tier (tiny ~7MB faster / small ~31MB more accurate). NOTE: the tier
# is BAKED into the ppocr sidecar image at build (via the compose build arg) — this
# env only labels parse provenance and MUST match the baked tier. Rebuild the
# sidecar (--build) to actually change the model tier.
#PPOCR_TIER=small

# === Document extraction (PDF + office → text) ===
# The api bundles NO document engine; it reads env only and calls an out-of-process
# provider. This REPLACES the old in-process pdf-parse. DOCUMENT_EXTRACTION_PROVIDER
# selects the engine: `local` (the Apache Tika sidecar — PDF + office + epub),
# `textin` (合合/TextIn xParse cloud, markdown output), or `none` (document parsing
# DISABLED → PDF/office uploads are skipped and a LOUD boot warning fires). The
# compose default keeps document parsing on via the docextract sidecar (shipped in
# the `production` profile), so you usually leave these unset.
#
# local Apache Tika sidecar. Selected + reached by:
#DOCUMENT_EXTRACTION_PROVIDER=local
#DOCEXTRACT_URL=http://docextract:8776/
# Apache Tika Server version — BAKED into the sidecar image at build (compose build
# arg TIKA_VERSION) AND surfaced as the api's parse-provenance label. One knob drives
# both; rebuild the sidecar (--build) to actually change the engine version.
#TIKA_VERSION=3.0.0
# Output flavor for the local Tika provider: "text" (default) or "markdown" (the
# Phase-2 rich tier — Tika XHTML → markdown, headings/lists/tables preserved).
#DOCEXTRACT_OUTPUT_FORMAT=markdown
#
# TextIn / 合合 xParse cloud vendor (dual static-header auth, sends bytes off-box).
# To use it instead of the local sidecar, set the provider + BOTH credentials:
#DOCUMENT_EXTRACTION_PROVIDER=textin
#DOCEXTRACT_TEXTIN_APP_ID=your-app-id
#DOCEXTRACT_TEXTIN_SECRET_CODE=your-secret-code
#
# LlamaParse (LlamaCloud) — the ASYNC cloud vendor (Bearer auth, submit→poll,
# markdown). Runs go through a durable poll job (no worker held during the wait).
#DOCUMENT_EXTRACTION_PROVIDER=llamaparse
#DOCEXTRACT_LLAMAPARSE_API_KEY=llx-your-key
# Poll cadence + wall-clock deadline for async jobs (defaults 5s / 10min):
#DOCEXTRACT_ASYNC_POLL_INTERVAL_MS=5000
#DOCEXTRACT_ASYNC_DEADLINE_MS=600000

# === Batch audio transcription (ASR / speech-to-text) ===
# The api bundles NO ASR engine; it reads env only and calls an out-of-process
# provider. TRANSCRIPTION_PROVIDER selects the engine: `none` (default; audio
# transcription is skipped and the AI audio-fallback degrades to "transcript
# unavailable") or `sherpa` (the sherpa-onnx sidecar, compose `asr` profile).
# AUDIO_FALLBACK_PROVIDER is a DEPRECATED alias. This is SEPARATE from the
# realtime Volcengine dictation gateway (VOLCENGINE_ASR_* — a different modality).
#
# sherpa-asr sidecar (SenseVoice-Small int8, zh/en/ja/ko/yue). The model is baked
# at build under the Alibaba FunASR Model License (NOT Apache-2.0). Selected +
# reached by:
#   docker compose --profile production --profile asr up -d --build sherpa-asr api
#TRANSCRIPTION_PROVIDER=sherpa
#TRANSCRIPTION_SHERPA_URL=http://sherpa-asr:8772/
#
# whisper sidecar (faster-whisper / CTranslate2). A second engine behind the same
# abstraction, MIT-licensed end-to-end (the permissive alternative to sherpa/
# SenseVoice). Model size is baked into the image (WHISPER_MODEL_SIZE build arg);
# TRANSCRIPTION_WHISPER_MODEL must match it (labels cache/provenance). Reached by:
#   docker compose --profile production --profile asr up -d --build whisper api
#TRANSCRIPTION_PROVIDER=whisper
#TRANSCRIPTION_WHISPER_URL=http://whisper:8773/
#TRANSCRIPTION_WHISPER_MODEL=small
# Best-effort inline budget (ms) for transcription on the outbound-LLM path
# (audio is often the whole turn, so this is larger than OCR's 4000).
#TRANSCRIPTION_INLINE_DEADLINE_MS=8000

# === Embedding (text → dense vector) — semantic memory + intelligent retrieval ===
# The api bundles NO embedding engine; it reads env only and calls an out-of-process
# provider. EMBEDDING_PROVIDER selects the engine: `none` (semantic memory indexing
# off — recall degrades to lexical, NOT an error), `local` (the bge-m3 sidecar), or
# `openai-compatible` (a cloud / self-host vendor). The compose default keeps
# semantic memory on via the local sidecar (shipped in the `production` profile), so
# you usually leave these unset.
#
# EMBEDDING_DIMENSION is the deployment-wide vector width; it MUST equal the pgvector
# column width (the boot guard asserts it) AND a width the provider can emit. 1024 =
# bge-m3 native + DashScope-v3 / Cohere-v3 / Jina-v3 / SiliconFlow-bge-m3. Changing
# it requires a re-embed migration (see docs/embedding-abstraction-layer-plan §5).
#EMBEDDING_DIMENSION=1024
#EMBEDDING_BATCH_SIZE=12
#
# local bge-m3 sidecar (onnxruntime, CPU, no torch — compose `production` profile):
#EMBEDDING_PROVIDER=local
#EMBEDDING_LOCAL_URL=http://embed:8775/
# Provenance/cache-key LABEL — must match the model baked into the sidecar image.
#EMBEDDING_LOCAL_MODEL=bge-m3
#
# openai-compatible cloud/self-host (OpenAI, 阿里百炼 DashScope compat, 智谱 Zhipu,
# 硅基流动 SiliconFlow, TEI, Ollama, vLLM). ⚠ Selecting a cloud provider sends memory
# text (the recall query + EVERY indexed passage) to EMBEDDING_OPENAI_BASE_URL — a
# PII-egress event. The host is logged with a startup WARN and MUST be https://.
# Pick a domestic provider (DashScope / Zhipu / SiliconFlow) to keep data in-region.
#EMBEDDING_PROVIDER=openai-compatible
#EMBEDDING_OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/
#EMBEDDING_OPENAI_API_KEY=sk-...
#EMBEDDING_OPENAI_MODEL=text-embedding-v3
# input_type → per-vendor field: `none` (symmetric — bge-m3, and the OpenAI-compat
# endpoints of DashScope/Zhipu/SiliconFlow) or `jina-task` (Jina honors top-level task).
#EMBEDDING_OPENAI_INPUT_ROLE_MODE=none
# Set true ONLY for MRL models that accept a `dimensions` param (DashScope v3/v4,
# Jina v3, Zhipu embedding-3, OpenAI v3). Sending it to others 400s / is ignored.
#EMBEDDING_OPENAI_SUPPORTS_DIMENSIONS=true
# Per-request text cap the facade splits larger batches to (DashScope compat ≈ 10,
# Gemini-compat = 1). 0 => no cap.
#EMBEDDING_OPENAI_MAX_BATCH=10

# === Realtime ASR (语音识别 / dictation) — the /ws/asr WebSocket gateway ===
# A SEPARATE modality from batch transcription above (streaming, not file-at-once).
# ASR_PROVIDER selects the provider (default `none` => realtime dictation is
# disabled; the null provider emits a clean asr.error). Options:
#   - `volcengine`: Volcengine 豆包 SAUC (cloud). Needs the VOLCENGINE_ASR_* creds.
#     NOTE: the pre-abstraction default was `volcengine`; existing deploys that set
#     VOLCENGINE_ASR_* must now ALSO set ASR_PROVIDER=volcengine explicitly.
#   - `sherpa-stream`: the self-hosted streaming sherpa-onnx sidecar (opt-in `asr`
#     compose profile), fully on-prem / no cloud egress. Accepts raw 16 kHz PCM only.
#       docker compose --profile production --profile asr up -d --build sherpa-asr-streaming api
#ASR_PROVIDER=volcengine
#VOLCENGINE_ASR_APP_ID=
#VOLCENGINE_ASR_ACCESS_TOKEN=
#VOLCENGINE_ASR_RESOURCE_ID=volc.seedasr.sauc.duration
#VOLCENGINE_ASR_WS_URL=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel_async
#
#ASR_PROVIDER=sherpa-stream
#REALTIME_ASR_SHERPA_URL=ws://sherpa-asr-streaming:8774/ws
