{
  "name": "@synapse/shared",
  "version": "0.1.0",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./automation": {
      "types": "./dist/automation/index.d.ts",
      "default": "./dist/automation/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/types/index.js"
    },
    "./constants": {
      "types": "./dist/constants/index.d.ts",
      "default": "./dist/constants/index.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "default": "./dist/utils/index.js"
    },
    "./schemas": {
      "types": "./dist/schemas/index.d.ts",
      "default": "./dist/schemas/index.js"
    },
    "./uuid": {
      "types": "./dist/uuid/index.d.ts",
      "default": "./dist/uuid/index.js"
    },
    "./emoji": {
      "types": "./dist/emoji/index.d.ts",
      "default": "./dist/emoji/index.js"
    },
    "./datetime": {
      "types": "./dist/datetime/index.d.ts",
      "default": "./dist/datetime/index.js"
    },
    "./chat-socket": {
      "types": "./dist/chat-socket/index.d.ts",
      "default": "./dist/chat-socket/index.js"
    },
    "./chat-state": {
      "types": "./dist/chat-state/index.d.ts",
      "default": "./dist/chat-state/index.js"
    },
    "./chat-queue": {
      "types": "./dist/chat-queue/index.d.ts",
      "default": "./dist/chat-queue/index.js"
    },
    "./pinyin": {
      "types": "./dist/pinyin/index.d.ts",
      "default": "./dist/pinyin/index.js"
    },
    "./access/policies": {
      "types": "./dist/access/policies/index.d.ts",
      "default": "./dist/access/policies/index.js"
    }
  },
  "scripts": {
    "prebuild": "rm -rf dist tsconfig.build.tsbuildinfo",
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc --watch",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "prepublishOnly": "node ../../scripts/prepublish-guard.mjs"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@synapse/device-protocol": "0.1.0",
    "tldts": "^6.1.86",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "tsx": "^4.20.0",
    "typescript": "^5.4.0"
  }
}
