[
  {
    "description": "origin scope matches exact origin (with matching operation)",
    "policies": [
      {
        "capability": "browser",
        "browser": {
          "action": "read",
          "scopeType": "origin",
          "origin": "https://example.com",
          "operations": ["page.read"]
        }
      }
    ],
    "request": {
      "action": "read",
      "origin": "https://example.com",
      "host": "example.com",
      "registrableDomain": "example.com",
      "operations": ["page.read"]
    },
    "expected": true
  },
  {
    "description": "host scope matches host",
    "policies": [
      {
        "capability": "browser",
        "browser": {
          "action": "read",
          "scopeType": "host",
          "host": "example.com",
          "operations": ["page.read"]
        }
      }
    ],
    "request": {
      "action": "read",
      "origin": "https://example.com:8443",
      "host": "example.com",
      "registrableDomain": "example.com",
      "operations": ["page.read"]
    },
    "expected": true
  },
  {
    "description": "domain scope matches registrable domain",
    "policies": [
      {
        "capability": "browser",
        "browser": {
          "action": "read",
          "scopeType": "domain",
          "registrableDomain": "example.com",
          "operations": ["page.read"]
        }
      }
    ],
    "request": {
      "action": "read",
      "origin": "https://sub.example.com",
      "host": "sub.example.com",
      "registrableDomain": "example.com",
      "operations": ["page.read"]
    },
    "expected": true
  },
  {
    "description": "origin scope rejects different origin",
    "policies": [
      {
        "capability": "browser",
        "browser": {
          "action": "read",
          "scopeType": "origin",
          "origin": "https://example.com",
          "operations": ["page.read"]
        }
      }
    ],
    "request": {
      "action": "read",
      "origin": "https://evil.example",
      "host": "evil.example",
      "registrableDomain": "example",
      "operations": ["page.read"]
    },
    "expected": false
  },
  {
    "description": "action mismatch denies (read grant cannot serve write request)",
    "policies": [
      {
        "capability": "browser",
        "browser": {
          "action": "read",
          "scopeType": "host",
          "host": "example.com",
          "operations": ["page.read"]
        }
      }
    ],
    "request": {
      "action": "write",
      "origin": "https://example.com",
      "host": "example.com",
      "registrableDomain": "example.com",
      "operations": ["page.input"]
    },
    "expected": false
  },
  {
    "description": "unknown scope type denies (safe default)",
    "policies": [
      {
        "capability": "browser",
        "browser": {
          "action": "read",
          "scopeType": "galactic",
          "host": "example.com",
          "operations": ["page.read"]
        }
      }
    ],
    "request": {
      "action": "read",
      "origin": "https://example.com",
      "host": "example.com",
      "registrableDomain": "example.com",
      "operations": ["page.read"]
    },
    "expected": false,
    "note": "Unknown scopeType must NOT grant access. This catches the historical 'default: return true' bug."
  },
  {
    "description": "v3.1 — grant operations=[page.read] denies page.input request",
    "policies": [
      {
        "capability": "browser",
        "browser": {
          "action": "write",
          "scopeType": "origin",
          "origin": "https://example.com",
          "operations": ["page.read"]
        }
      }
    ],
    "request": {
      "action": "write",
      "origin": "https://example.com",
      "host": "example.com",
      "registrableDomain": "example.com",
      "operations": ["page.input"]
    },
    "expected": false
  },
  {
    "description": "v3.1 — grant operations=[page.read,page.input] permits page.read request (write covers read)",
    "policies": [
      {
        "capability": "browser",
        "browser": {
          "action": "write",
          "scopeType": "origin",
          "origin": "https://example.com",
          "operations": ["page.read", "page.input"]
        }
      }
    ],
    "request": {
      "action": "read",
      "origin": "https://example.com",
      "host": "example.com",
      "registrableDomain": "example.com",
      "operations": ["page.read"]
    },
    "expected": true
  },
  {
    "description": "v3.1 — grant operations=[page.read,page.input] permits page.input request",
    "policies": [
      {
        "capability": "browser",
        "browser": {
          "action": "write",
          "scopeType": "origin",
          "origin": "https://example.com",
          "operations": ["page.read", "page.input"]
        }
      }
    ],
    "request": {
      "action": "write",
      "origin": "https://example.com",
      "host": "example.com",
      "registrableDomain": "example.com",
      "operations": ["page.input"]
    },
    "expected": true
  },
  {
    "description": "v3.1 — grant without operations field denies any operation request (fail-closed)",
    "policies": [
      {
        "capability": "browser",
        "browser": {
          "action": "write",
          "scopeType": "origin",
          "origin": "https://example.com"
        }
      }
    ],
    "request": {
      "action": "write",
      "origin": "https://example.com",
      "host": "example.com",
      "registrableDomain": "example.com",
      "operations": ["page.input"]
    },
    "expected": false,
    "note": "v3.1 fail-closed: grants missing the operations field deny any operation-requesting call. No legacy compat."
  },
  {
    "description": "v3.1 — grant operations=[screenshot.capture] denies page.input",
    "policies": [
      {
        "capability": "browser",
        "browser": {
          "action": "write",
          "scopeType": "origin",
          "origin": "https://example.com",
          "operations": ["screenshot.capture"]
        }
      }
    ],
    "request": {
      "action": "write",
      "origin": "https://example.com",
      "host": "example.com",
      "registrableDomain": "example.com",
      "operations": ["page.input"]
    },
    "expected": false
  }
]
