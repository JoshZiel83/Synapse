[
  {
    "description": "read grant matches read request",
    "policies": [{ "capability": "cua", "cua": { "access": "read" } }],
    "request": { "access": "read" },
    "expected": true
  },
  {
    "description": "write grant satisfies read request (write covers read)",
    "policies": [{ "capability": "cua", "cua": { "access": "write" } }],
    "request": { "access": "read" },
    "expected": true,
    "note": "Aligned with device-side enforcement in packages/device-runtime/src/builtins/cua.ts — a principal with cua:write should not be asked again for cua:read."
  },
  {
    "description": "no cua policy denies",
    "policies": [
      {
        "capability": "filesystem",
        "filesystem": { "access": "read", "pathPrefixes": ["/tmp"] }
      }
    ],
    "request": { "access": "read" },
    "expected": false
  }
]
