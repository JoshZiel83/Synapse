# Declarative model-groups config (example template).
#
# Copy this file to `model-groups.yaml` in the same directory, then fill in the
# referenced ${ENV} variables (in your .env / environment). The real
# model-groups.yaml is gitignored — only this .example is tracked.
#
# Apply it with:   npm run db:seed:model-groups
# It also runs automatically as part of:   npm run db:rebuild
#
# Semantics:
#   - PLATFORM scope only (no per-workspace groups via file import).
#   - CREATE-ONLY / idempotent: re-running never overwrites groups or items you
#     have edited in the UI. Groups dedupe by `name`, items by `displayName`.
#   - Secrets MUST be ${ENV_VAR} references — a literal key here is rejected.
#   - At most one group may set `isDefault: true`, and it is honored only on a
#     fresh database (it never steals the default from a UI selection).

version: 1
groups:
  - name: Platform Default
    description: Default platform model group
    routingStrategy: priority_failover # priority_failover | weighted_random
    isDefault: true
    items:
      - displayName: Claude Sonnet
        # vendor drives both the SDK provider-kind (anthropic|openai|
        # openai_compatible) and the UI label. Known vendors: anthropic, openai,
        # deepseek, bigmodel. providerKind is derived from vendor (override only
        # if you know what you're doing).
        vendor: anthropic
        apiKey: ${ANTHROPIC_API_KEY}
        baseUrl: https://api.anthropic.com
        modelName: claude-sonnet-4-20250514
        maxOutputTokens: 4096
        # priority: 0          # lower wins under priority_failover
        # weight: 100          # relative share under weighted_random
        # capabilityTags: []   # free-form capability labels
        # features:            # typed per-binding feature flags
        #   apiStyle: chat     # openai only: chat | responses
        #   serverTools: [web_search, web_fetch]   # anthropic only
        #   multimodal:
        #     supported: true
        #     types: [image]
        #   crossTurnToolHistory: false
        # providerOptions: {}  # opaque, passed verbatim to the AI SDK provider
