{
  "name": "@synapse/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "pretypecheck": "npm run build -w @synapse/device-protocol -w @synapse/shared -w @synapse/device-runtime",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "start": "node dist/index.js",
    "guard:db": "node scripts/guard-db-paradigm.mjs",
    "pretest": "npm run guard:db && npm run typecheck",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "test:integration": "bash tests/integration/scripts/run-integration.sh",
    "test:integration:keep-stack": "KEEP_CONTAINERS=1 bash tests/integration/scripts/run-integration.sh",
    "test:integration:llm-smoke": "tsx --test tests/integration/manual/llm-smoke.test.ts",
    "test:conformance": "tsx --test \"src/modules/runtime-authorizations/conformance.test.ts\"",
    "test:coverage": "tsx --test --experimental-test-coverage --test-coverage-include=\"src/modules/access/*.ts\" --test-coverage-exclude=\"src/**/*.test.ts\" \"src/modules/access/*.test.ts\" \"src/test/helpers/db.test.ts\"",
    "db:bootstrap": "tsx src/infrastructure/database/bootstrap.ts && npm run db:codegen",
    "db:bootstrap:runtime": "tsx src/infrastructure/database/bootstrap.ts",
    "db:seed": "tsx src/infrastructure/database/seed.ts",
    "db:seed:builtin-mcp": "tsx src/infrastructure/database/seed-builtin-mcp-plugins.ts",
    "db:rebuild": "tsx src/infrastructure/database/rebuild.ts && npm run db:codegen",
    "db:rebuild:runtime": "tsx src/infrastructure/database/rebuild.ts",
    "db:codegen": "node scripts/db-codegen.mjs",
    "db:codegen:verify": "npm run db:codegen -- --verify",
    "memory:bootstrap-model": "tsx src/modules/memory/bootstrap-model.ts"
  },
  "dependencies": {
    "@better-auth/expo": "1.6.13",
    "@dicebear/collection": "^9.4.2",
    "@dicebear/core": "^9.4.2",
    "@fastify/cookie": "^9.4.0",
    "@fastify/cors": "^9.0.0",
    "@fastify/jwt": "^8.0.0",
    "@fastify/multipart": "^8.3.1",
    "@fastify/websocket": "^10.0.0",
    "@huggingface/transformers": "^3.8.0",
    "@larksuiteoapi/node-sdk": "^1.59.0",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@synapse/device-protocol": "*",
    "@synapse/device-runtime": "*",
    "@synapse/shared": "*",
    "@wecom/aibot-node-sdk": "1.0.6",
    "better-auth": "1.6.13",
    "bullmq": "^5.8.0",
    "cron-parser": "^4.9.0",
    "dingtalk-stream": "^2.1.5",
    "dotenv": "^16.4.0",
    "eventsource-parser": "^3.0.6",
    "fast-deep-equal": "^3.1.3",
    "fastify": "^4.28.0",
    "fastify-plugin": "^4.5.1",
    "ioredis": "^5.4.0",
    "ipaddr.js": "^1.9.1",
    "js-yaml": "^4.1.0",
    "kysely": "^0.28.17",
    "lru-cache": "^10.4.3",
    "pdf-parse": "^1.1.4",
    "pg": "^8.12.0",
    "pino": "^9.0.0",
    "pino-pretty": "^11.0.0",
    "sharp": "^0.34.5",
    "tesseract.js": "^7.0.0",
    "undici": "^5.29.0",
    "unzipper": "^0.12.3",
    "uuid": "^11.0.0",
    "ws": "^8.20.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.1.0",
    "@types/pg": "^8.11.0",
    "@types/unzipper": "^0.10.11",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "kysely-codegen": "^0.20.0",
    "testcontainers": "^10.28.0",
    "tsx": "^4.16.0",
    "typescript": "^5.4.0"
  }
}
