# Env template for the IM-test ad-hoc scripts under packages/api/scripts/.
# Copy this to packages/api/scripts/.env, fill in real values, and run scripts
# with `set -a && . scripts/.env && set +a && npx tsx scripts/<file>.mjs`.
#
# Never commit a filled copy. The .gitignore already excludes
# packages/*/scripts/*.local.* — name your filled copy with .local.* if you
# want to be explicit.

# Feishu app credentials (issue at https://open.feishu.cn/app)
FEISHU_APP_ID=
FEISHU_APP_SECRET=
