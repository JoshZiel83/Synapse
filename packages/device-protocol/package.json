{
  "name": "@synapse/device-protocol",
  "version": "0.1.0",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./enums": {
      "types": "./dist/enums.d.ts",
      "default": "./dist/enums.js"
    },
    "./schemas": {
      "types": "./dist/schemas.d.ts",
      "default": "./dist/schemas.js"
    },
    "./tunnel": {
      "types": "./dist/tunnel.d.ts",
      "default": "./dist/tunnel.js"
    },
    "./browser-tools": {
      "types": "./dist/browser-tools.d.ts",
      "default": "./dist/browser-tools.js"
    },
    "./instant": {
      "types": "./dist/instant.d.ts",
      "default": "./dist/instant.js"
    },
    "./instant/schema": {
      "types": "./dist/instant.schema.d.ts",
      "default": "./dist/instant.schema.js"
    }
  },
  "scripts": {
    "prebuild": "rm -rf dist tsconfig.build.tsbuildinfo",
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc --watch",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "prepublishOnly": "node ../../scripts/prepublish-guard.mjs"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "typescript": "^5.4.0"
  }
}
