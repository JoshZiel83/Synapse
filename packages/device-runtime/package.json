{
  "name": "@synapse/device-runtime",
  "version": "0.1.0",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "synapse-device": "./dist/bin.js"
  },
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=23"
  },
  "files": [
    "dist",
    "bundles/manifest.json",
    "bundles/manifest.production.template.json",
    "bundles/README.md",
    "bundles/build-scripts",
    "bundles/archives"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc --watch",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "prepublishOnly": "node ../../scripts/prepublish-guard.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "@synapse/device-protocol": "0.1.0",
    "@synapse/shared": "0.1.0",
    "semver": "7.7.4",
    "tar": "7.5.13",
    "trash": "9.0.0",
    "unzipper": "0.12.3",
    "ws": "8.20.0",
    "zod": "4.3.6"
  },
  "optionalDependencies": {
    "chrome-devtools-mcp": "0.7.0",
    "@synapse/device-runtime-bundles-linux-x64": "0.1.0",
    "@synapse/device-runtime-bundles-linux-arm64": "0.1.0",
    "@synapse/device-runtime-bundles-darwin-x64": "0.1.0",
    "@synapse/device-runtime-bundles-darwin-arm64": "0.1.0",
    "@synapse/device-runtime-bundles-win32-x64": "0.1.0",
    "@synapse/device-runtime-bundles-win32-arm64": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@types/semver": "^7.5.8",
    "@types/unzipper": "^0.10.10",
    "@types/ws": "^8.5.13",
    "tsx": "^4.20.0",
    "typescript": "^5.4.0"
  }
}
