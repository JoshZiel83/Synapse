# Mobile (Expo) reads .env ONLY from this directory, never the monorepo root.
# `./setup.sh` generates the real .env here (fanned out from the root .env).
# Copy this file to .env for manual local builds.

EXPO_PUBLIC_API_URL=https://your-api-host.example.com/api/v1
# Public origin Better Auth is mounted on. Leave empty for same-origin deploys
# (falls back to the API origin); set it only when the browser-facing public
# origin differs from the internal API origin.
EXPO_PUBLIC_AUTH_ORIGIN=
# Base path the web build is served under (matches nginx /mobile/ mount).
EXPO_BASE_URL=/mobile
