# Mobile (Expo) reads .env ONLY from this directory, never the monorepo root.
# `./setup.sh` generates the real .env here (fanned out from the root .env).
# Copy this file to .env for manual local builds.

EXPO_PUBLIC_API_URL=https://your-api-host.example.com/api/v1
# Public origin Better Auth is mounted on. Leave empty for same-origin deploys
# (falls back to the API origin); set it only when the browser-facing public
# origin differs from the internal API origin.
EXPO_PUBLIC_AUTH_ORIGIN=
# Base path the web build is served under (matches nginx /mobile/ mount).
EXPO_BASE_URL=/mobile

# Sentry (mobile project — its OWN DSN, distinct from the api's SENTRY_DSN and
# web's NEXT_PUBLIC_SENTRY_DSN; never reuse one value). Inlined by
# babel-preset-expo at export/build time — native builds must export these in
# the BUILD environment. Empty => Sentry + the mobile→api W3C traceparent
# bridge are off. Trace headers are pinned to the API/auth origins only.
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_ENVIRONMENT=
# Sentry head sample rate for mobile traces (default 0.1 when empty; the
# traceparent header attaches regardless — flags 00 when unsampled).
EXPO_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=
