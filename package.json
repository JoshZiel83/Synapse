{
  "name": "synapse",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/shared",
    "packages/api",
    "packages/web-next"
  ],
  "scripts": {
    "dev:api": "npm run dev -w packages/api",
    "dev:web": "npm run dev -w packages/web-next",
    "dev:mock-chat": "node .workbuddy/mock-chat-completions-server.cjs",
    "build": "npm run build -w packages/shared && npm run build -w packages/api && npm run build -w packages/web-next",
    "build:shared": "npm run build -w packages/shared",
    "build:api": "npm run build -w packages/api",
    "build:web": "npm run build -w packages/shared && npm run build -w packages/web-next",
    "db:migrate": "npm run db:migrate -w packages/api",
    "db:upgrade:auth-qr-login": "npm run db:upgrade:auth-qr-login -w packages/api",
    "db:upgrade:interactions": "npm run db:upgrade:interactions -w packages/api",
    "db:upgrade:transport-account-owners": "npm run db:upgrade:transport-account-owners -w packages/api",
    "db:seed": "npm run db:seed -w packages/api",
    "db:reset": "npm run db:reset -w packages/api"
  },
  "overrides": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "shadcn": "^4.0.5"
  }
}
