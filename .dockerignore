**/node_modules
**/.next
**/dist
**/*.tsbuildinfo
.git
.refer
coverage
storage
# Rust build outputs — the fs-helper Rust stage rebuilds from source (--locked),
# so the host's target/ (can be >1G) must never enter the build context.
**/target
# Never ship secrets into the build context. Docker does NOT read .gitignore,
# so .env files (root + nested worktrees + infra/) must be excluded here.
# `.env.*` also covers transient backups (e.g. .env.predeploy.*) the deploy
# scripts could create. `.env.example` templates are explicitly re-allowed so
# they still ship.
.env
**/.env
.env.*
**/.env.*
!.env.example
!**/.env.example
# Defense-in-depth: the deploy scripts back .env up to $TMPDIR (outside the repo),
# but if TMPDIR points inside the tree the backup would otherwise land here — its
# name doesn't start with `.env`, so exclude it explicitly too.
synapse-env-predeploy.*
**/synapse-env-predeploy.*
# Local dev scratch that would otherwise bloat the context by tens of GB.
.claude/
.worktrees/
# Declarative model-groups config: keep the real file out of the image (it is
# bind-mounted :ro at runtime via docker-compose). The .yaml holds only ${ENV}
# refs, but excluding it is defense-in-depth + avoids baking local state. The
# .example template still ships.
packages/api/config/model-groups.yaml
