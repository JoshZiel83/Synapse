// Draft SpiceDB schema for the Synapse authorization redesign.
//
// Notes:
// - PostgreSQL remains the business datastore.
// - SpiceDB is the authorization datastore.
// - platform:synapse is the singleton platform object.
// - This schema focuses on runtime authorization objects, not marketplace catalog editing.

definition user {}

definition platform {
    relation super_admin: user
    relation workspace_admin: user
    relation model_admin: user
    relation support: user
    relation auditor: user
    relation workspace: workspace

    permission principal = workspace->principal + super_admin + workspace_admin + model_admin
    permission manage = super_admin
    permission manage_workspaces = super_admin + workspace_admin
    permission manage_models = super_admin + model_admin
    permission support_access = super_admin + support
    permission audit = super_admin + auditor
}

definition workspace {
    relation platform: platform
    relation owner: workspace_member
    relation admin: workspace_member
    relation member: workspace_member
    relation guest: workspace_member
    relation model_admin: workspace_member
    relation actor_admin: workspace_member
    relation skill_admin: workspace_member
    relation plugin_admin: workspace_member
    relation memory_admin: workspace_member
    relation relay_admin: workspace_member
    relation conversation_admin: workspace_member
    relation actor: actor

    permission principal = owner + admin + member + model_admin + actor_admin + skill_admin + plugin_admin + memory_admin + relay_admin + conversation_admin + actor
    permission view = principal + guest
    permission manage = owner + admin + platform->manage_workspaces
    permission manage_members = owner + admin + platform->manage_workspaces
    permission manage_actors = owner + admin + actor_admin + platform->manage_workspaces
    permission use_actors = owner + admin + member + model_admin + actor_admin + skill_admin + plugin_admin + memory_admin + relay_admin + conversation_admin
    permission manage_conversations = owner + admin + conversation_admin + platform->manage_workspaces
    permission create_conversation = owner + admin + member + model_admin + actor_admin + skill_admin + plugin_admin + memory_admin + relay_admin + conversation_admin
    permission manage_skills = owner + admin + skill_admin + platform->manage_workspaces
    permission manage_plugins = owner + admin + plugin_admin + platform->manage_workspaces
    permission manage_memories = owner + admin + memory_admin + platform->manage_workspaces
    permission manage_relays = owner + admin + relay_admin + platform->manage_workspaces
    permission manage_models = owner + admin + model_admin + platform->manage_models
}

definition workspace_member {
    relation self: workspace_member
    relation workspace: workspace
    relation user: user

    permission principal = self
}

definition actor {
    relation workspace: workspace
    relation owner: workspace_member | actor
    relation editor: workspace_member | actor
    relation discover_workspace: workspace
    relation discover_workspace_member: workspace_member
    relation discover_principal: workspace_member | actor
    relation discover_conversation: conversation
    relation invoke_workspace: workspace
    relation invoke_workspace_member: workspace_member
    relation invoke_principal: workspace_member | actor
    relation invoke_conversation: conversation
    relation receive_workspace: workspace
    relation receive_workspace_member: workspace_member
    relation receive_principal: workspace_member | actor
    relation receive_conversation: conversation
    relation memory_reader_workspace: workspace
    relation memory_reader_workspace_member: workspace_member
    relation memory_reader_principal: workspace_member | actor
    relation memory_reader_conversation: conversation
    relation memory_editor_workspace: workspace
    relation memory_editor_workspace_member: workspace_member
    relation memory_editor_principal: workspace_member | actor
    relation memory_editor_conversation: conversation
    relation memory_retargeter_workspace: workspace
    relation memory_retargeter_workspace_member: workspace_member
    relation memory_retargeter_principal: workspace_member | actor
    relation memory_retargeter_conversation: conversation
    relation memory_deleter_workspace: workspace
    relation memory_deleter_workspace_member: workspace_member
    relation memory_deleter_principal: workspace_member | actor
    relation memory_deleter_conversation: conversation

    permission discover = owner + editor + workspace->manage_actors + discover_workspace->principal + discover_workspace_member->principal + discover_principal + discover_conversation->principal
    permission view = discover
    permission invoke = owner + editor + workspace->manage_actors + invoke_workspace->principal + invoke_workspace_member->principal + invoke_principal + invoke_conversation->principal
    permission receive_message = owner + editor + workspace->manage_actors + receive_workspace->principal + receive_workspace_member->principal + receive_principal + receive_conversation->principal
    permission memory_read = owner + editor + workspace->manage_actors + memory_reader_workspace->principal + memory_reader_workspace_member->principal + memory_reader_principal + memory_reader_conversation->memory_read
    permission memory_edit = owner + editor + workspace->manage_actors + memory_editor_workspace->manage_memories + memory_editor_workspace_member->principal + memory_editor_principal + memory_editor_conversation->memory_edit
    permission memory_retarget = owner + editor + workspace->manage_actors + memory_retargeter_workspace->manage_memories + memory_retargeter_workspace_member->principal + memory_retargeter_principal + memory_retargeter_conversation->memory_retarget
    permission memory_delete = owner + workspace->manage_actors + memory_deleter_workspace->manage_memories + memory_deleter_workspace_member->principal + memory_deleter_principal + memory_deleter_conversation->memory_delete
    permission edit = owner + editor + workspace->manage_actors
    permission grant = edit
    permission delete = owner + workspace->manage_actors
}

definition actor_conversation {
    relation actor: actor
    relation conversation: conversation

    permission principal = actor & conversation->principal
    permission memory_read = actor->memory_read & conversation->memory_read
    permission memory_edit = actor->memory_edit & conversation->memory_edit
    permission memory_retarget = actor->memory_retarget & conversation->memory_retarget
    permission memory_delete = actor->memory_delete & conversation->memory_delete
}

definition conversation_workspace {
    relation conversation: conversation
    relation workspace: workspace
    relation participant: workspace_member | actor

    permission principal = participant + participant->principal
}

definition conversation {
    relation participant: workspace_member | actor
    relation moderator: workspace_member | actor
    relation admin: workspace_member | actor
    relation blocked: workspace_member | actor
    relation sender: workspace_member | actor
    relation manager: workspace_member | actor
    relation member_manager: workspace_member | actor
    relation resource_attacher: workspace_member | actor
    relation memory_reader: workspace_member | actor
    relation memory_editor: workspace_member | actor
    relation memory_retargeter: workspace_member | actor
    relation memory_deleter: workspace_member | actor

    permission principal = participant + participant->principal + moderator + moderator->principal + admin + admin->principal
    permission blocked_principal = blocked + blocked->principal
    permission moderator_principal = moderator + moderator->principal
    permission admin_principal = admin + admin->principal
    permission sender_principal = sender + sender->principal
    permission manager_principal = manager + manager->principal
    permission member_manager_principal = member_manager + member_manager->principal
    permission resource_attacher_principal = resource_attacher + resource_attacher->principal
    permission memory_editor_principal = memory_editor + memory_editor->principal
    permission memory_retargeter_principal = memory_retargeter + memory_retargeter->principal
    permission memory_deleter_principal = memory_deleter + memory_deleter->principal

    permission view = principal - blocked_principal
    permission send = (principal + sender_principal) & view
    permission moderate = (moderator_principal + admin_principal) & view
    permission manage = (admin_principal + manager_principal) & view
    permission manage_members = (admin_principal + manager_principal + member_manager_principal) & view
    permission attach_resources = (moderator_principal + admin_principal + resource_attacher_principal) & view
    permission memory_read = view
    permission memory_edit = (moderator_principal + admin_principal + memory_editor_principal) & view
    permission memory_retarget = (admin_principal + memory_retargeter_principal) & view
    permission memory_delete = (admin_principal + memory_deleter_principal) & view
}

definition memory {
    relation workspace: workspace
    relation owner_workspace_member: workspace_member
    relation owner_workspace: workspace
    relation owner_conversation: conversation
    relation owner_actor: actor
    relation owner_actor_conversation: actor_conversation

    permission read = owner_workspace_member + owner_workspace->view + owner_conversation->memory_read + owner_actor->memory_read + owner_actor_conversation->memory_read + workspace->manage_memories
    permission recall = read
    permission edit = owner_workspace_member + owner_workspace->manage_memories + owner_conversation->memory_edit + owner_actor->memory_edit + owner_actor_conversation->memory_edit + workspace->manage_memories
    permission retarget = owner_workspace_member + owner_workspace->manage_memories + owner_conversation->memory_retarget + owner_actor->memory_retarget + owner_actor_conversation->memory_retarget + workspace->manage_memories
    permission delete = owner_workspace_member + owner_workspace->manage_memories + owner_conversation->memory_delete + owner_actor->memory_delete + owner_actor_conversation->memory_delete + workspace->manage_memories
}

definition model_profile {
    relation group: model_group

    permission use = group->use
    permission view = group->view
    permission edit = group->edit
    permission attach = group->attach
    permission grant = group->grant
    permission delete = group->delete
}

definition model_group {
    relation owner_platform: platform
    relation owner_workspace: workspace
    relation owner_workspace_member: workspace_member
    relation use_platform: platform
    relation use_workspace: workspace
    relation use_workspace_member: workspace_member
    relation use_actor: actor

    permission use = owner_workspace_member + owner_workspace->manage_models + owner_platform->manage_models + use_platform->principal + use_workspace->principal + use_workspace_member->principal + use_actor
    permission view = edit + use
    permission edit = owner_workspace_member + owner_workspace->manage_models + owner_platform->manage_models
    permission attach = edit
    permission grant = edit
    permission delete = edit
}

// Example tuples:
//
// platform:synapse#workspace@workspace:ws_01
// workspace:ws_01#owner@workspace_member:wm_01
// workspace:ws_01#member@workspace_member:wm_02
// workspace:ws_01#actor@actor:a_01
// conversation:conv_01#workspace@workspace:ws_01
// conversation:conv_01#participant@workspace_member:wm_02
// conversation:conv_01#participant@actor:a_01
// workspace:ws_01#member@workspace_member:wm_02
// workspace_member:wm_02#self@workspace_member:wm_02
// workspace_member:wm_02#workspace@workspace:ws_01
// workspace_member:wm_02#user@user:u_02
// model_group:group_01#owner_workspace@workspace:ws_01
// model_group:group_01#owner_workspace_member@workspace_member:wm_02
// model_group:group_01#use_workspace@workspace:ws_01
// model_profile:profile_01#group@model_group:group_01

definition installed_skill {
    relation workspace: workspace
    relation owner: workspace_member | actor
    relation editor: workspace_member | actor
    relation use_actor: actor
    relation use_workspace_member: workspace_member
    relation use_actor_conversation: actor_conversation
    relation use_conversation_workspace: conversation_workspace
    relation use_workspace: workspace

    permission use = owner + editor + workspace->manage_skills + use_actor + use_workspace_member->principal + use_actor_conversation->principal + use_conversation_workspace->principal + use_workspace->principal
    permission view = use
    permission edit = owner + editor + workspace->manage_skills
    permission grant = edit
    permission delete = owner + workspace->manage_skills
}

definition plugin_installation {
    relation workspace: workspace
    relation owner: workspace_member | actor
    relation editor: workspace_member | actor
    relation use_actor: actor
    relation use_workspace_member: workspace_member
    relation use_actor_conversation: actor_conversation
    relation use_conversation_workspace: conversation_workspace
    relation use_workspace: workspace

    permission use = owner + editor + workspace->manage_plugins + use_actor + use_workspace_member->principal + use_actor_conversation->principal + use_conversation_workspace->principal + use_workspace->principal
    permission view = use
    permission edit = owner + editor + workspace->manage_plugins
    permission grant = edit
    permission delete = owner + workspace->manage_plugins
}

definition relay_device {
    relation workspace: workspace
    relation owner: workspace_member | actor
    relation operator: workspace_member | actor
    relation runtime_authorizer: workspace_member

    permission view = owner + operator + workspace->manage_relays
    permission manage = owner + operator + workspace->manage_relays
    permission invoke = view
    permission authorize_runtime_access = owner + operator + runtime_authorizer + workspace->manage_relays
    permission grant = manage
    permission delete = owner + workspace->manage_relays
}

definition relay_exposure {
    relation workspace: workspace
    relation device: relay_device
    relation owner: workspace_member | actor
    relation operator: workspace_member | actor
    relation use_actor: actor
    relation use_workspace_member: workspace_member
    relation use_actor_conversation: actor_conversation
    relation use_conversation_workspace: conversation_workspace
    relation use_workspace: workspace

    permission view = device->view + owner + operator + workspace->manage_relays
    permission invoke = device->invoke + owner + operator + workspace->manage_relays + use_actor + use_workspace_member->principal + use_actor_conversation->principal + use_conversation_workspace->principal + use_workspace->principal
    permission request_authorization = invoke
    permission edit = owner + operator + workspace->manage_relays
    permission grant = edit
    permission delete = owner + workspace->manage_relays
}
