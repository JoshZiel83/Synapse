# Placeholder — DO NOT commit a real htpasswd here.
#
# The real `infra/verdaccio/htpasswd` is gitignored (bcrypt hashes are
# credential material). Generate it before the first `docker compose up`:
#
#   # create / append a publisher (bcrypt):
#   docker run --rm httpd:2 htpasswd -nbB publisher 'STRONG_PASSWORD' \
#     >> infra/verdaccio/htpasswd
#
# Then obtain a token for that user (written to the publisher's
# ~/.npmrc, never into this repo):
#
#   npm login --registry=http://localhost:4873/
#
# config.yaml sets `auth.htpasswd.max_users: -1`, so only users that
# already exist in this file can log in / publish — there is no
# self-service signup.
