# Copy to `.env` and adjust. `.env` is gitignored (it pins your real
# registry host); this `.env.example` is the committed template.
#
# NPM_REGISTRY drives:
#   - the publish commands (npm publish --registry="$NPM_REGISTRY")
#   - the @synapse:registry scope mapping in the repo-root .npmrc
#     (via ${NPM_REGISTRY} interpolation)
# This is the PUBLISH-SIDE registry URL — i.e. how the machine RUNNING the
# publish reaches Verdaccio (often an internal/localhost address).
# Local verification uses localhost; production points at your real host
# behind TLS (e.g. https://npm.your-host.tld/).
NPM_REGISTRY=http://localhost:4873/

# Host port the Verdaccio container publishes on.
VERDACCIO_PORT=4873

# PUBLIC_NPM_REGISTRY_URL is a SEPARATE, EXTERNAL-reachable registry URL —
# the address END USERS' machines use. The API server reads it
# (config.remoteAgent.npmRegistryUrl) to build the one-click daemon
# install command shown on the dashboard. It must NOT be an internal
# address like http://verdaccio:4873 or http://localhost:4873 (those are
# unreachable from a user's laptop). If UNSET, the dashboard command
# degrades to a bare `synapse-remote-agent-daemon ...` (no --registry),
# which only works if the user has already configured @synapse:registry in
# their own ~/.npmrc — i.e. it stops being a true one-click command. Set
# this in the API service's environment (not just here) for production.
#   PUBLIC_NPM_REGISTRY_URL=https://npm.your-host.tld/
PUBLIC_NPM_REGISTRY_URL=http://localhost:4873/

